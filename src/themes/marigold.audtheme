{
  "format": "audiform-theme",
  "version": 1,
  "id": "marigold",
  "name": "Secret Theme",
  "base": "light",
  "secret": true,
  "description": "Found, not listed.",
  "author": "The Audiform contributors",
  "css": "\n:root[data-theme=\"marigold\"] {\n  color-scheme: light;\n  --surface-0: #fdfaf0;\n  --surface-1: #fdfaf0;\n  --surface-2: #f6efd8;\n  --menu-bg: #fbf3dc;\n  --surface-3: #f3e6bc;\n  --border: #1a1818;\n  --border-strong: #1a1818;\n\n  --text: #1a1818;\n  --text-dim: #3d3733;\n  --text-faint: #7a6f63;\n\n  --accent: #e8741f;\n  --accent-dim: #f3c392;\n  --playhead: #d8262b;\n  --value: #1b73b8;\n  --gutter: transparent;\n  --danger: #d8262b;\n  --selected-text: #1a1818;\n\n  --lane-a: #fffdf3;\n  --lane-b: #f9f4e0;\n  --lane-selected: #ffe3b0;\n  --track-gap: #1a1818;\n  --header-a: #f4ecd2;\n  --header-b: #efe5c4;\n\n  --clip-1: #e8741f;\n  --clip-2: #2a8fd8;\n  --clip-3: #43a047;\n  --clip-4: #d8262b;\n  --clip-5: #f2c230;\n  --clip-6: #a9532c;\n  --clip-7: #2fa7a0;\n  --clip-body-alpha: 0.6;\n  --clip-wave-tone: -0.25;\n  --clip-gloss: 0;\n\n  --font-ui: \"Segoe UI\", \"Source Sans 3\", system-ui, sans-serif;\n\n  --spectrum-low: #1f3a8a;\n  --spectrum-high: #f6c433;\n  --phase-low: #43a047;\n  --phase-high: #d8262b;\n}\n/* Paper with pen swirls, and a few spots of colour. */\n:root[data-theme=\"marigold\"] body {\n  background: #fbf6e6 url(asset:wall) 0 0 / 384px 384px repeat;\n}\n:root[data-theme=\"marigold\"] :is(header.top, main.body, .dv-dockview, .dv-grid-view, .dv-split-view-container, .dv-view-container, .dv-view) {\n  background: transparent !important;\n}\n/* Panels: white paper in a pen outline that never quite closes the same way twice. */\n:root[data-theme=\"marigold\"] .dockview-theme-altaudio {\n  --dv-group-view-background-color: var(--surface-1);\n  --dv-tabs-and-actions-container-background-color: #f4ecd2;\n  --dv-activegroup-visiblepanel-tab-background-color: #ffe3b0;\n  --dv-inactivegroup-visiblepanel-tab-background-color: #fbf3dc;\n  --dv-activegroup-hiddenpanel-tab-background-color: transparent;\n  --dv-inactivegroup-hiddenpanel-tab-background-color: transparent;\n  --dv-tab-divider-color: #1a1818;\n}\n:root[data-theme=\"marigold\"] .dockview-theme-altaudio .dv-groupview {\n  border: 5px solid transparent;\n  border-radius: 9px 14px 10px 15px / 14px 9px 15px 10px;\n  overflow: hidden;\n  background-clip: padding-box;\n  box-shadow: 0 0 0 3px #1a1818 inset, 3px 3px 0 rgba(26, 24, 24, 0.55);\n}\n:root[data-theme=\"marigold\"] .dockview-theme-altaudio .dv-tab {\n  border-radius: 8px 12px 0 0;\n}\n/* Bars: paper with a heavy pen line and one stripe of orange. */\n:root[data-theme=\"marigold\"] :is(.menubar, .strip, footer.status) {\n  background: #fdf8e8;\n  color: #1a1818;\n  border-color: #1a1818;\n}\n:root[data-theme=\"marigold\"] .menubar {\n  border-bottom: 3px solid #1a1818;\n  box-shadow: 0 3px 0 #f2992f;\n}\n:root[data-theme=\"marigold\"] .menubar .top {\n  color: #1a1818;\n  font-weight: 600;\n}\n:root[data-theme=\"marigold\"] .menubar::before {\n  content: \"\";\n  align-self: center;\n  flex: none;\n  width: 120px;\n  height: 18px;\n  margin: 3px 16px 0 10px;\n  background: url(asset:title) center / contain no-repeat;\n  pointer-events: none;\n}\n/* Controls: pen-outlined paper, orange when hovered. */\n:root[data-theme=\"marigold\"] :is(button, select):not(.row, .top, .tool, .context button, .view, .clock, .grab, .fold, .chev, .x, .name, .chan) {\n  border: 2px solid #1a1818;\n  border-radius: 6px 10px 7px 11px / 10px 6px 11px 7px;\n  background: #fffdf3;\n  color: #1a1818;\n}\n:root[data-theme=\"marigold\"] :is(button, select):not(.row, .top, .tool, .context button, .view, .clock, .grab, .fold, .chev, .x, .name, .chan):hover {\n  background: #ffd9a3;\n}\n:root[data-theme=\"marigold\"] :is(.menubar .top:hover, .menubar .top.open) {\n  background: #fffdf3;\n  color: #1a1818;\n}\n",
  "assets": {
    "wall": "data:image/webp;base64,",
    "title": "data:image/webp;base64,"
  }
}