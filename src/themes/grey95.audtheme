{
  "format": "audiform-theme",
  "version": 1,
  "id": "grey95",
  "name": "Grey Desktop '95",
  "base": "light",
  "description": "Flat grey windows with raised and sunken edges on a teal desktop, like a 1995 computer.",
  "author": "The Audiform contributors",
  "css": "\n:root[data-theme=\"grey95\"] {\n  color-scheme: light;\n  --surface-0: #c0c0c0;\n  --surface-1: #c0c0c0;\n  --surface-2: #c0c0c0;\n  --menu-bg: #c0c0c0;\n  --surface-3: #d4d0c8;\n  --border: #808080;\n  --border-strong: #404040;\n\n  --text: #000000;\n  --text-dim: #202020;\n  --text-faint: #606060;\n\n  --accent: #000080;\n  --accent-dim: #8080c0;\n  --playhead: #ff0000;\n  --value: #000080;\n  --gutter: #008080;\n  --danger: #c00000;\n  --selected-text: #ffffff;\n\n  --lane-a: #ffffff;\n  --lane-b: #f0f0f0;\n  --lane-selected: #cfd8ff;\n  --track-gap: #808080;\n  --header-a: #c0c0c0;\n  --header-b: #c0c0c0;\n\n  --clip-1: #000080;\n  --clip-2: #008080;\n  --clip-3: #008000;\n  --clip-4: #800080;\n  --clip-5: #808000;\n  --clip-6: #800000;\n  --clip-7: #0000ff;\n  --clip-body-alpha: 0.55;\n  --clip-wave-tone: 0;\n  --clip-gloss: 0;\n\n  --font-ui: \"MS Sans Serif\", \"Microsoft Sans Serif\", Tahoma, \"Segoe UI\", system-ui, sans-serif;\n\n  --spectrum-low: #000000;\n  --spectrum-high: #ffff00;\n  --phase-low: #008000;\n  --phase-high: #ff0000;\n}\n:root[data-theme=\"grey95\"] body {\n  background: #008080;\n}\n:root[data-theme=\"grey95\"] :is(header.top, main.body, .dv-dockview, .dv-grid-view, .dv-split-view-container, .dv-view-container, .dv-view) {\n  background: transparent !important;\n}\n/* Raised grey windows on the teal desktop. */\n:root[data-theme=\"grey95\"] .dockview-theme-altaudio {\n  --dv-group-view-background-color: #c0c0c0;\n  --dv-tabs-and-actions-container-background-color: #c0c0c0;\n  --dv-activegroup-visiblepanel-tab-background-color: #c0c0c0;\n  --dv-inactivegroup-visiblepanel-tab-background-color: #c0c0c0;\n  --dv-activegroup-hiddenpanel-tab-background-color: #b4b4b4;\n  --dv-inactivegroup-hiddenpanel-tab-background-color: #b4b4b4;\n  --dv-tab-divider-color: #808080;\n}\n:root[data-theme=\"grey95\"] .dockview-theme-altaudio .dv-groupview {\n  border: 3px solid transparent;\n  border-radius: 0;\n  overflow: hidden;\n  background-clip: padding-box;\n  box-shadow: inset -1px -1px #0a0a0a, inset 1px 1px #ffffff, inset -2px -2px #808080, inset 2px 2px #dfdfdf;\n}\n:root[data-theme=\"grey95\"] .dockview-theme-altaudio .dv-tab {\n  border-radius: 0;\n  box-shadow: inset -1px 0 #808080, inset 1px 1px #ffffff;\n}\n:root[data-theme=\"grey95\"] .dockview-theme-altaudio .dv-active-tab {\n  background: #000080;\n  color: #ffffff;\n}\n:root[data-theme=\"grey95\"] :is(.menubar, .strip, footer.status) {\n  background: #c0c0c0;\n  color: #000;\n  border-color: #808080;\n  box-shadow: inset 0 1px #ffffff, inset 0 -1px #808080;\n}\n:root[data-theme=\"grey95\"] :is(button, select):not(.row, .top, .tool, .context button, .view, .clock, .grab, .fold, .chev, .x, .name, .chan) {\n  border: 0;\n  border-radius: 0;\n  background: #c0c0c0;\n  color: #000;\n  box-shadow: inset -1px -1px #0a0a0a, inset 1px 1px #ffffff, inset -2px -2px #808080, inset 2px 2px #dfdfdf;\n}\n:root[data-theme=\"grey95\"] :is(button, select):not(.row, .top, .tool, .context button, .view, .clock, .grab, .fold, .chev, .x, .name, .chan):active {\n  box-shadow: inset 1px 1px #0a0a0a, inset -1px -1px #ffffff, inset 2px 2px #808080, inset -2px -2px #dfdfdf;\n}\n:root[data-theme=\"grey95\"] :is(input[type=\"text\"], input[type=\"number\"], select, textarea) {\n  border-radius: 0;\n  background: #ffffff;\n  color: #000;\n  box-shadow: inset 1px 1px #0a0a0a, inset -1px -1px #ffffff, inset 2px 2px #808080, inset -2px -2px #dfdfdf;\n}\n:root[data-theme=\"grey95\"] :is(.menubar .top:hover, .menubar .top.open) {\n  background: #000080;\n  color: #ffffff;\n}\n\n:root[data-theme=\"grey95\"] header.top {\n  background: #c0c0c0 !important;\n}\n"
}