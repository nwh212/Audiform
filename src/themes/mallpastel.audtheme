{
  "format": "audiform-theme",
  "version": 1,
  "id": "mallpastel",
  "name": "Mall Pastel '95 (モール・パステル '95)",
  "base": "light",
  "description": "A pastel shopping plaza with marble columns.",
  "author": "The Audiform contributors",
  "canvasLook": {
    "markCursor": true
  },
