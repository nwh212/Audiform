  "css": ":root[data-theme=\"mallpastel\"] {\n  color-scheme: light;\n\n  --surface-0: #fdf0f7;\n  --surface-1: #ffffff;\n  --surface-2: #fbf7ff;\n  --menu-bg: #ffffff;\n  --surface-3: #f3ecff;\n  --border: #e2d6f5;\n  --border-strong: #c9b8ff;\n\n  --text: #3b2a5c;\n  --text-dim: #5f4f80;\n  --text-faint: #85769f;\n\n  --accent: #7458d6;\n  --accent-dim: #c9b8ff;\n  --playhead: #ff3f95;\n  --value: #0f6f69;\n  --gutter: #e8def5;\n  --danger: #d6336c;\n  --selected-text: #ffffff;\n  --lane-a: rgba(255, 255, 255, 0.74);\n  --lane-b: rgba(253, 246, 251, 0.74);\n  --lane-selected: rgba(236, 229, 255, 0.88);\n  --track-gap: #e8def5;\n  --header-a: #ffffff;\n  --header-b: #fbf7ff;\n  --clip-1: #ff8fc7;\n  --clip-2: #2ec4b6;\n  --clip-3: #a98bff;\n  --clip-4: #ffb84d;\n  --clip-5: #5cc8ff;\n  --clip-6: #ff8a6b;\n  --clip-7: #6fe0b8;\n  --clip-body-alpha: 0.38;\n  --clip-wave-tone: -0.5;\n  --clip-gloss: 0;\n\n  --font-ui: \"Nunito\", \"Source Sans 3\", \"Segoe UI\", system-ui, sans-serif;\n  --font-mono: \"Cascadia Mono\", \"Consolas\", ui-monospace, monospace;\n  --mp-lavender: #b39cff;\n  --mp-mint: #9ff0d6;\n  --mp-pink: #ff8fc7;\n  --mp-ink: #3b2a5c;\n  --mp-hi: #ffffff;\n  --mp-lo: #8c7bb0;\n  --mp-raised: var(--mp-hi) var(--mp-lo) var(--mp-lo) var(--mp-hi);\n  --mp-sunken: var(--mp-lo) var(--mp-hi) var(--mp-hi) var(--mp-lo);\n  --mp-marble: url(asset:mallpastel-marble) 0 0 / 400px 400px;\n  --mp-checker: linear-gradient(45deg, var(--mp-lavender) 25%, transparent 25%, transparent 75%, var(--mp-lavender) 75%) 0 0 / 12px 12px,\n    linear-gradient(45deg, var(--mp-lavender) 25%, var(--mp-mint) 25%, var(--mp-mint) 75%, var(--mp-lavender) 75%) 6px 6px / 12px 12px;\n  --mp-japanese: \"MS Gothic\", \"Yu Gothic\", \"Hiragino Sans\", \"Noto Sans CJK JP\", \"Noto Sans JP\", sans-serif;\n\n  --spectrum-low: #fdf0f7;\n  --spectrum-high: #4a2f8c;\n  --phase-low: #2ec4b6;\n  --phase-high: #ff5fa8;\n}\n:root[data-theme=\"mallpastel\"] body {\n  padding: 0 26px;\n  background:\n    url(asset:mallpastel-capital) left top / 26px 30px no-repeat,\n    url(asset:mallpastel-capital) right top / 26px 30px no-repeat,\n    url(asset:mallpastel-base) left bottom / 26px 24px no-repeat,\n    url(asset:mallpastel-base) right bottom / 26px 24px no-repeat,\n    url(asset:mallpastel-shaft) left top / 26px 12px repeat-y,\n    url(asset:mallpastel-shaft) right top / 26px 12px repeat-y,\n    linear-gradient(180deg, #ffd9ec 0%, #fdf0f7 45%, #e9f9f4 100%) fixed;\n}\n:root[data-theme=\"mallpastel\"] .shell {\n  grid-template-rows: auto auto 1fr var(--row-height);\n}\n:root[data-theme=\"mallpastel\"] header.top {\n  position: relative;\n  z-index: 50;\n  flex-direction: column;\n  border-bottom: 0;\n}\n:root[data-theme=\"mallpastel\"] header.top .menubar {\n  height: 24px;\n}\n:root[data-theme=\"mallpastel\"] header.top::before {\n  content: \"\";\n  display: block;\n  height: 12px;\n  background: var(--mp-checker);\n}\n:root[data-theme=\"mallpastel\"] header.top::after {\n  content: \"\";\n  display: block;\n  height: 14px;\n  background: #f6f1fb url(asset:mallpastel-meander) left center / 24px 14px repeat-x;\n  border-top: 1px solid var(--border-strong);\n  border-bottom: 1px solid var(--border-strong);\n}\n:root[data-theme=\"mallpastel\"] :is(.menubar, .strip, footer.status) {\n  background: var(--mp-marble), #ffffff;\n  color: var(--mp-ink);\n  border-color: var(--border-strong);\n}\n:root[data-theme=\"mallpastel\"] .menubar::before {\n  content: \"ＡＵＤＩＦＯＲＭ\";\n  align-self: center;\n  margin: 0 10px 0 10px;\n  font-weight: 800;\n  letter-spacing: 0.06em;\n  color: #8a2f74;\n  pointer-events: none;\n}\n:root[data-theme=\"mallpastel\"] footer.status::after {\n  content: \"ショッピングモール ・ ａｅｓｔｈｅｔｉｃ\";\n  margin-left: auto;\n  padding-right: 8px;\n  font-family: var(--mp-japanese);\n  color: #6a4fb3;\n}\n:root[data-theme=\"mallpastel\"] :is(.menubar .top:hover, .menubar .top.open) {\n  background: var(--accent);\n  color: #ffffff;\n}\n:root[data-theme=\"mallpastel\"] .dockview-theme-altaudio {\n  --dv-group-view-background-color: #ffffff;\n  --dv-tabs-and-actions-container-background-color: #fbf7ff;\n  --dv-activegroup-visiblepanel-tab-background-color: #ffffff;\n  --dv-inactivegroup-visiblepanel-tab-background-color: #f6f1fb;\n  --dv-activegroup-hiddenpanel-tab-background-color: transparent;\n  --dv-inactivegroup-hiddenpanel-tab-background-color: transparent;\n  --dv-activegroup-visiblepanel-tab-color: #8a2f74;\n  --dv-activegroup-hiddenpanel-tab-color: var(--text-dim);\n  --dv-inactivegroup-hiddenpanel-tab-color: var(--text-dim);\n  --dv-tab-divider-color: var(--border);\n  --dv-active-sash-color: var(--mp-lavender);\n  --dv-drag-over-background-color: rgba(179, 156, 255, 0.18);\n}\n:root[data-theme=\"mallpastel\"] .dockview-theme-altaudio .dv-tabs-and-actions-container {\n  background: var(--mp-marble), #fbf7ff;\n  border-bottom: 1px solid var(--border-strong);\n}\n:root[data-theme=\"mallpastel\"] .dockview-theme-altaudio .dv-groupview {\n  border: 2px solid;\n  border-color: var(--mp-raised);\n  box-shadow: 1px 1px 0 #5d4b86;\n  overflow: hidden;\n}\n:root[data-theme=\"mallpastel\"] .dockview-theme-altaudio .dv-tab {\n  font-weight: 700;\n}\n:root[data-theme=\"mallpastel\"] .lanes {\n  background: url(asset:mallpastel-sun) right 40px top 16px / 260px 220px no-repeat;\n}\n:root[data-theme=\"mallpastel\"] :is(.menubar .dropdown, .context, .dv-context-menu) {\n  background: #ffffff;\n  border: 2px solid;\n  border-color: var(--mp-raised);\n  border-radius: 0;\n  box-shadow: 1px 1px 0 #5d4b86, 5px 5px 0 rgba(140, 123, 176, 0.35);\n}\n:root[data-theme=\"mallpastel\"] :is(.menubar .dropdown, .context, .dv-context-menu) :is(.sep, .dv-context-menu-separator) {\n  height: 0;\n  background: transparent;\n  border-top: 1px solid var(--border-strong);\n  border-bottom: 1px solid #ffffff;\n}\n:root[data-theme=\"mallpastel\"] :is(.menubar .row.active, .context button.active, .dv-context-menu-item:hover, tr.sel, tr.selected, li.sel, li.selected, .item.sel, .item.selected, .file.sel, .file.selected, [role=\"option\"][aria-selected=\"true\"]) {\n  background: var(--accent);\n  color: #ffffff;\n}\n:root[data-theme=\"mallpastel\"] :is(.dialog, [role=\"dialog\"], [role=\"alertdialog\"]) {\n  background: #ffffff;\n  border: 2px solid;\n  border-color: var(--mp-raised);\n  border-radius: 0;\n  box-shadow: 1px 1px 0 #5d4b86, 6px 6px 0 rgba(140, 123, 176, 0.3);\n}\n:root[data-theme=\"mallpastel\"] :is(.dialog, [role=\"dialog\"], [role=\"alertdialog\"]) > :is(h1:first-child, header:first-child) {\n  padding: 4px 8px;\n  background: linear-gradient(90deg, #2ec4b6, var(--mp-mint) 35%, var(--mp-lavender));\n  color: #1d1236;\n}\n:root[data-theme=\"mallpastel\"] :is(.dialog, [role=\"dialog\"], [role=\"alertdialog\"], .strip, .bar:has(> .transport)) :is(button, .tool) {\n  background: #f3ecff;\n  color: var(--mp-ink);\n  border: 2px solid;\n  border-color: var(--mp-raised);\n  border-radius: 0;\n}\n:root[data-theme=\"mallpastel\"] :is(.dialog, [role=\"dialog\"], [role=\"alertdialog\"], .strip, .bar:has(> .transport)) :is(button, .tool):active:not(:disabled) {\n  border-color: var(--mp-sunken);\n}\n:root[data-theme=\"mallpastel\"] :is(.dialog, [role=\"dialog\"], [role=\"alertdialog\"]) button.primary {\n  background: var(--mp-mint);\n  color: #1d1236;\n  outline: 1px dotted var(--mp-ink);\n  outline-offset: -5px;\n}\n:root[data-theme=\"mallpastel\"] :is(.strip, .bar:has(> .transport)) :is(.tool.on, button.on, .view.on) {\n  background: var(--mp-mint);\n  color: #0f4f4a;\n  border-color: var(--mp-sunken);\n}\n:root[data-theme=\"mallpastel\"] .bar:has(> .transport) .transport .tool.rec.on {\n  background: #ffd0e4;\n  color: #b0204f;\n}\n:root[data-theme=\"mallpastel\"] .bar .clock {\n  background: var(--mp-ink);\n  color: var(--mp-mint);\n  border: 2px solid;\n  border-color: var(--mp-sunken);\n  border-radius: 0;\n}\n:root[data-theme=\"mallpastel\"] :is(input[type=\"text\"], input[type=\"number\"], input[type=\"search\"], input:not([type]), textarea, select) {\n  background: #ffffff;\n  color: var(--mp-ink);\n  border: 2px solid;\n  border-color: var(--mp-sunken);\n  border-radius: 0;\n}\n:root[data-theme=\"mallpastel\"] :is(input[type=\"checkbox\"], input[type=\"radio\"], input[type=\"range\"]) {\n  accent-color: var(--accent);\n}\n:root[data-theme=\"mallpastel\"] ::selection {\n  background: var(--accent);\n  color: #ffffff;\n}\n:root[data-theme=\"mallpastel\"] ::-webkit-scrollbar {\n  width: 14px;\n  height: 14px;\n}\n:root[data-theme=\"mallpastel\"] ::-webkit-scrollbar-track {\n  background:\n    linear-gradient(45deg, #e4dcef 25%, transparent 25%, transparent 75%, #e4dcef 75%) 0 0 / 4px 4px,\n    linear-gradient(45deg, #e4dcef 25%, #ffffff 25%, #ffffff 75%, #e4dcef 75%) 2px 2px / 4px 4px;\n}\n:root[data-theme=\"mallpastel\"] ::-webkit-scrollbar-thumb {\n  background: #ffd9ec;\n  border: 2px solid;\n  border-color: var(--mp-raised);\n}\n:root[data-theme=\"mallpastel\"] :is(.levels .bar, .phase .legend .bar, .phase .track) {\n  position: relative;\n}\n:root[data-theme=\"mallpastel\"] :is(.levels .bar, .phase .legend .bar, .phase .track)::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background: repeating-linear-gradient(90deg, transparent 0 6px, #ffffff 6px 7px);\n}\n:root[data-theme=\"mallpastel\"] .phase .mark {\n  background: var(--playhead);\n}\n:root[data-theme=\"mallpastel\"], :root[data-theme=\"mallpastel\"] body, :root[data-theme=\"mallpastel\"] :is(button, select, a, summary, [role=\"button\"], [role=\"menuitem\"], .dv-tab, input[type=\"checkbox\"], input[type=\"radio\"]):not(:disabled) {\n  cursor: url(asset:mallpastel-arrow) 2 1, default;\n}\n:root[data-theme=\"mallpastel\"] [data-aero-cursor] {\n  cursor: url(asset:mallpastel-arrow) 2 1, default !important;\n}\n:root[data-theme=\"mallpastel\"] footer.status::after {\n  margin-left: 12px;\n}\n:root[data-theme=\"mallpastel\"] footer.status .discord {\n  border: 1px solid var(--border-strong);\n  border-radius: 999px;\n  background: #fbf7ff;\n  color: #8a2f74;\n  font-weight: 700;\n  opacity: 1;\n}\n:root[data-theme=\"mallpastel\"] footer.status .discord:hover {\n  background: var(--accent);\n  border-color: var(--accent);\n  color: #ffffff;\n}\n",
  "assets": {
    "mallpastel-arrow": "data:image/svg+xml;base64,",
    "mallpastel-base": "data:image/svg+xml;base64,",
    "mallpastel-busy": "data:image/svg+xml;base64,",
    "mallpastel-capital": "data:image/svg+xml;base64,",
    "mallpastel-ew": "data:image/svg+xml;base64,",
    "mallpastel-grab": "data:image/svg+xml;base64,",
    "mallpastel-grabbing": "data:image/svg+xml;base64,",
    "mallpastel-marble": "data:image/svg+xml;base64,",
    "mallpastel-meander": "data:image/svg+xml;base64,",
    "mallpastel-nesw": "data:image/svg+xml;base64,",
    "mallpastel-ns": "data:image/svg+xml;base64,",
    "mallpastel-nwse": "data:image/svg+xml;base64,",
    "mallpastel-shaft": "data:image/svg+xml;base64,",
    "mallpastel-sun": "data:image/svg+xml;base64,",
    "mallpastel-text": "data:image/svg+xml;base64,",
    "mallpastel-move": "data:image/svg+xml;base64,",
    "cursor-trim-left": "data:image/svg+xml;base64,",
    "cursor-trim-right": "data:image/svg+xml;base64,"
  }
}
