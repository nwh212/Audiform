{
  "format": "audiform-theme",
  "version": 1,
  "id": "crt",
  "name": "CRT",
  "base": "dark",
  "description": "A color tube monitor: scanlines over phosphor stripes, bright things glowing onto the glass, dark corners and a slow flicker.",
  "author": "Audiform",
  "canvasLook": {
    "pixel": false
  },
  "css": ":root[data-theme=\"crt\"] {\n  --radius-field: 2px;\n  --radius-menu: 3px;\n  --radius-dialog: 4px;\n  color-scheme: dark;\n  --surface-0: #05060c;\n  --surface-1: #0a0c16;\n  --surface-2: #10131f;\n  --menu-bg: #0c0f1a;\n  --surface-3: #171b2b;\n  --border: #1f2538;\n  --border-strong: #3a4260;\n  --text: #dfe9ff;\n  --text-dim: #8e9cc4;\n  --text-faint: #5a6689;\n\n  --accent: #ff5fd2;\n  --accent-dim: #8a2f73;\n  --playhead: #fff7a8;\n  --value: #7df5ff;\n  --gutter: #020308;\n  --danger: #ff5a4a;\n  --selected-text: #0a0612;\n  --on-accent: #0a0612;\n\n  --lane-a: #090b14;\n  --lane-b: #0b0e19;\n  --lane-selected: #161a2e;\n  --track-gap: #010205;\n  --header-a: #0d1020;\n  --header-b: #101427;\n  --clip-1: #7df5ff;\n  --clip-2: #ff5fd2;\n  --clip-3: #baff5e;\n  --clip-4: #ffb74d;\n  --clip-5: #9d7cff;\n  --clip-6: #5effb0;\n  --clip-7: #ff7b7b;\n  --clip-body-alpha: 0.18;\n  --clip-wave-tone: 0.3;\n  --clip-gloss: 0;\n\n  --font-ui: \"Segoe UI\", \"Noto Sans\", \"DejaVu Sans\", system-ui, sans-serif;\n  --font-mono: \"Cascadia Mono\", \"Consolas\", \"DejaVu Sans Mono\", ui-monospace, monospace;\n  --font-size: 12px;\n  --font-size-small: 11px;\n  --spectrum-low: #140a2e;\n  --spectrum-high: #7df5ff;\n  --phase-low: #ff5fd2;\n  --phase-high: #7df5ff;\n  /* Halation: the glow a bright phosphor throws onto the glass around it. */\n  --c-glow-text: 0 0 1px rgba(223, 233, 255, 0.6), 0 0 6px rgba(125, 245, 255, 0.35);\n  --c-glow-accent: 0 0 2px rgba(255, 95, 210, 0.9), 0 0 10px rgba(255, 95, 210, 0.55), 0 0 22px rgba(255, 95, 210, 0.25);\n  --c-glow-value: 0 0 2px rgba(125, 245, 255, 0.8), 0 0 8px rgba(125, 245, 255, 0.45);\n}\n:root[data-theme=\"crt\"] body {\n  background: #020308;\n  text-shadow: var(--c-glow-text);\n}\n/* The glass: scanlines, the red-green-blue phosphor stripes under them, a\n   slow flicker, and the darkening toward the corners of a curved tube. */\n:root[data-theme=\"crt\"] body::after {\n  content: \"\";\n  position: fixed;\n  inset: 0;\n  pointer-events: none;\n  z-index: 100000;\n  background:\n    repeating-linear-gradient(90deg, rgba(255, 40, 40, 0.05) 0 1px, rgba(40, 255, 40, 0.04) 1px 2px, rgba(40, 80, 255, 0.06) 2px 3px),\n    repeating-linear-gradient(rgba(0, 0, 0, 0) 0 2px, rgba(0, 0, 0, 0.16) 2px 3px),\n    radial-gradient(ellipse at center, rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.32) 100%);\n  mix-blend-mode: multiply;\n  animation: crt-flicker 6s steps(60) infinite;\n}\n@keyframes crt-flicker {\n  0%, 92%, 100% { opacity: 1; }\n  93% { opacity: 0.93; }\n  94% { opacity: 1; }\n  96% { opacity: 0.96; }\n}\n/* A faint bloom over everything: light bleeding across the glass. */\n:root[data-theme=\"crt\"] body::before {\n  content: \"\";\n  position: fixed;\n  inset: 0;\n  pointer-events: none;\n  z-index: 99999;\n  background: radial-gradient(ellipse at 50% 40%, rgba(125, 245, 255, 0.05), rgba(0, 0, 0, 0) 60%);\n  mix-blend-mode: screen;\n}\n:root[data-theme=\"crt\"] .dockview-theme-altaudio .dv-groupview {\n  border: 1px solid var(--border);\n  box-shadow: inset 0 0 0 1px #000, inset 0 0 24px rgba(125, 245, 255, 0.04);\n}\n/* Bright things glow: the accent, values, lit buttons, the playhead. */\n:root[data-theme=\"crt\"] :is(.value, .clock, .db, .num, .time, output) {\n  text-shadow: var(--c-glow-value);\n}\n:root[data-theme=\"crt\"] :is(button.on, .tool.on, .view.on, .ms.on, [aria-pressed=\"true\"]) {\n  box-shadow: 0 0 6px rgba(255, 95, 210, 0.45), inset 0 0 4px rgba(255, 95, 210, 0.25);\n  text-shadow: var(--c-glow-accent);\n}\n:root[data-theme=\"crt\"] .bar:has(> .transport) .transport .tool.rec.on {\n  box-shadow: 0 0 8px rgba(255, 90, 74, 0.7);\n  text-shadow: 0 0 6px rgba(255, 90, 74, 0.9);\n}\n:root[data-theme=\"crt\"] .bar .clock {\n  background: #02030a;\n  color: var(--value);\n  border: 1px solid var(--border-strong);\n  text-shadow: var(--c-glow-value);\n  box-shadow: inset 0 0 12px rgba(125, 245, 255, 0.08);\n}\n:root[data-theme=\"crt\"] :is(.menubar .row.active, .context button.active, tr.sel, tr.selected, li.sel, li.selected, .item.sel, .item.selected, .file.sel, .file.selected) {\n  background: var(--accent);\n  color: var(--selected-text);\n  text-shadow: none;\n  box-shadow: 0 0 10px rgba(255, 95, 210, 0.5);\n}\n:root[data-theme=\"crt\"] :is(.menubar .dropdown, .context, .dialog, [role=\"dialog\"]) {\n  border: 1px solid var(--border-strong);\n  box-shadow: 0 0 0 1px #000, 0 0 18px rgba(125, 245, 255, 0.12), 0 10px 30px rgba(0, 0, 0, 0.6);\n}\n:root[data-theme=\"crt\"] :is(input[type=\"text\"], input[type=\"number\"], input[type=\"search\"], input:not([type]), textarea, select) {\n  background: #02030a;\n  color: var(--value);\n  border: 1px solid var(--border-strong);\n  text-shadow: var(--c-glow-value);\n}\n:root[data-theme=\"crt\"] :is(input[type=\"checkbox\"], input[type=\"radio\"], input[type=\"range\"]) {\n  accent-color: var(--accent);\n}\n:root[data-theme=\"crt\"] ::selection {\n  background: var(--accent);\n  color: var(--selected-text);\n}\n:root[data-theme=\"crt\"] ::-webkit-scrollbar {\n  width: 10px;\n  height: 10px;\n}\n:root[data-theme=\"crt\"] ::-webkit-scrollbar-track {\n  background: #02030a;\n}\n:root[data-theme=\"crt\"] ::-webkit-scrollbar-thumb {\n  background: var(--border-strong);\n  border: 2px solid #02030a;\n  border-radius: 5px;\n  box-shadow: inset 0 0 4px rgba(125, 245, 255, 0.25);\n}\n:root[data-theme=\"crt\"] ::-webkit-scrollbar-thumb:hover {\n  background: var(--text-dim);\n}\n/* Meters and the phase wheel's legend: lit segments on dark glass. */\n:root[data-theme=\"crt\"] :is(.levels .bar, .phase .legend .bar, .phase .track) {\n  position: relative;\n  box-shadow: 0 0 6px rgba(125, 245, 255, 0.2);\n}\n:root[data-theme=\"crt\"] :is(.levels .bar, .phase .legend .bar, .phase .track)::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background: repeating-linear-gradient(90deg, transparent 0 3px, rgba(2, 3, 10, 0.75) 3px 4px);\n}\n:root[data-theme=\"crt\"] .phase .mark {\n  background: var(--accent);\n  box-shadow: 0 0 6px rgba(255, 95, 210, 0.8);\n}\n:root[data-theme=\"crt\"] footer.status .discord {\n  border: 1px solid var(--border-strong);\n  background: #02030a;\n  color: var(--value);\n  text-shadow: var(--c-glow-value);\n}\n",
  "assets": {}
}
