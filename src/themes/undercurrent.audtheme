{
  "format": "audiform-theme",
  "version": 1,
  "id": "undercurrent",
  "name": "Secret Theme",
  "base": "dark",
  "secret": true,
  "description": "Found, not listed.",
  "author": "The Audiform contributors",
  "css": ":root[data-theme=\"undercurrent\"] {\n  color-scheme: dark;\n  --surface-0: rgba(5, 10, 34, 0.62);\n  --surface-1: rgba(8, 18, 54, 0.58);\n  --surface-2: rgba(12, 28, 78, 0.70);\n  --menu-bg: #0d1d52;\n  --surface-3: rgba(20, 48, 110, 0.74);\n  --border: rgba(110, 190, 225, 0.30);\n  --border-strong: rgba(130, 214, 232, 0.55);\n\n  --text: #e8f4f5;\n  --text-dim: #a9cbd8;\n  --text-faint: #6f95ad;\n\n  --accent: #4cd2e2;\n  --accent-dim: #1f7f9c;\n  --playhead: #d8e84a;\n  --value: #9ee6ee;\n  --gutter: transparent;\n  --danger: #e2603f;\n  --selected-text: #031028;\n\n  --lane-a: rgba(6, 14, 46, 0.52);\n  --lane-b: rgba(10, 22, 62, 0.52);\n  --lane-selected: rgba(30, 80, 150, 0.78);\n  --track-gap: rgba(2, 6, 22, 0.45);\n  --header-a: rgba(12, 30, 84, 0.72);\n  --header-b: rgba(16, 38, 100, 0.72);\n\n  --clip-1: #2f6fd0;\n  --clip-2: #2fb6c8;\n  --clip-3: #6a5fd0;\n  --clip-4: #c8dc4a;\n  --clip-5: #e2603f;\n  --clip-6: #3fa58a;\n  --clip-7: #a8dce8;\n  --clip-body-alpha: 0.42;\n  --clip-wave-tone: 0.45;\n  --clip-gloss: 0.6;\n\n  --font-ui: \"Segoe UI\", \"Source Sans 3\", system-ui, sans-serif;\n\n  --spectrum-low: #050a22;\n  --spectrum-high: #d8f2ee;\n  --phase-low: #2fb6c8;\n  --phase-high: #d8e84a;\n}\n\n/* The picture: swirled paint under a deep water, fixed to the window. */\n:root[data-theme=\"undercurrent\"] body {\n  background: #050a22 url(asset:water) center / cover no-repeat fixed;\n}\n:root[data-theme=\"undercurrent\"] :is(header.top, main.body, .dv-dockview, .dv-grid-view, .dv-split-view-container, .dv-view-container, .dv-view) {\n  background: transparent !important;\n}\n\n/* Panels: tinted water, edged with a thin bright line like a folded wave. */\n:root[data-theme=\"undercurrent\"] .dockview-theme-altaudio {\n  --dv-group-view-background-color: var(--surface-1);\n  --dv-tabs-and-actions-container-background-color: transparent;\n  --dv-activegroup-visiblepanel-tab-background-color: rgba(22, 56, 124, 0.85);\n  --dv-inactivegroup-visiblepanel-tab-background-color: rgba(14, 34, 88, 0.7);\n  --dv-activegroup-hiddenpanel-tab-background-color: transparent;\n  --dv-inactivegroup-hiddenpanel-tab-background-color: transparent;\n  --dv-tab-divider-color: transparent;\n}\n:root[data-theme=\"undercurrent\"] .dockview-theme-altaudio .dv-groupview {\n  border: 4px solid transparent;\n  border-radius: 16px 6px 16px 6px;\n  overflow: hidden;\n  background-clip: padding-box;\n  box-shadow: 0 0 0 1px var(--border) inset, 0 0 18px rgba(76, 210, 226, 0.12), 0 6px 18px rgba(0, 0, 0, 0.5);\n}\n:root[data-theme=\"undercurrent\"] .dockview-theme-altaudio .dv-tab {\n  border-radius: 12px 12px 0 0;\n}\n\n/* Bars: dark water with a lime-to-aqua hairline. */\n:root[data-theme=\"undercurrent\"] :is(.menubar, .strip, footer.status) {\n  background: linear-gradient(rgba(14, 34, 92, 0.92), rgba(6, 14, 48, 0.92));\n  color: var(--text);\n  border-color: var(--border-strong);\n}\n:root[data-theme=\"undercurrent\"] .menubar {\n  border-bottom: 2px solid transparent;\n  border-image: linear-gradient(90deg, #d8e84a, #4cd2e2 40%, #2f6fd0 75%, #e2603f) 1;\n}\n\n/* Controls: rippled glass. */\n:root[data-theme=\"undercurrent\"] :is(button, select):not(.row, .top, .tool, .context button, .view, .clock, .grab, .fold, .chev, .x, .name, .chan) {\n  border-radius: 10px 4px 10px 4px;\n  border: 1px solid var(--border-strong);\n  background: linear-gradient(rgba(40, 96, 170, 0.75), rgba(14, 40, 100, 0.75));\n  color: var(--text);\n}\n:root[data-theme=\"undercurrent\"] :is(button, select):not(.row, .top, .tool, .context button, .view, .clock, .grab, .fold, .chev, .x, .name, .chan):hover {\n  background: linear-gradient(rgba(60, 140, 200, 0.85), rgba(22, 64, 130, 0.85));\n  border-color: var(--playhead);\n}\n:root[data-theme=\"undercurrent\"] :is(.menubar .top:hover, .menubar .top.open) {\n  background: var(--accent);\n  color: #031028;\n}\n\n/* The title: wavy lettering in place of the plain bar. */\n:root[data-theme=\"undercurrent\"] .menubar::before {\n  content: \"\";\n  align-self: center;\n  flex: none;\n  width: 80px;\n  height: 21px;\n  margin: 0 16px 0 10px;\n  background: url(asset:title) center / contain no-repeat;\n  pointer-events: none;\n}\n",
  "assets": {
    "water": "data:image/webp;base64,",
    "title": "data:image/webp;base64,"
  }
}