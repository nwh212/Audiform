{
  "format": "audiform-theme",
  "version": 1,
  "id": "mallnight",
  "name": "Mall Pastel '95 Night (モール・パステル '95 ナイト)",
  "base": "dark",
  "description": "The same plaza after closing.",
  "author": "The Audiform contributors",
  "canvasLook": {
    "markCursor": true
  },
  "pointers": {
    "text": {
      "asset": "mallpastel-text",
