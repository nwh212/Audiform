  "css": ":root[data-theme=\"mallnight\"] body {\n  padding: 0 26px;\n  background:\n    url(asset:mallpastel-capital) left top / 26px 30px no-repeat,\n    url(asset:mallpastel-capital) right top / 26px 30px no-repeat,\n    url(asset:mallpastel-base) left bottom / 26px 24px no-repeat,\n    url(asset:mallpastel-base) right bottom / 26px 24px no-repeat,\n    url(asset:mallpastel-shaft) left top / 26px 12px repeat-y,\n    url(asset:mallpastel-shaft) right top / 26px 12px repeat-y,\n    linear-gradient(180deg, #ffd9ec 0%, #fdf0f7 45%, #e9f9f4 100%) fixed;\n}\n:root[data-theme=\"mallnight\"] .shell {\n  grid-template-rows: auto auto 1fr var(--row-height);\n}\n:root[data-theme=\"mallnight\"] header.top {\n  position: relative;\n  z-index: 50;\n  flex-direction: column;\n  border-bottom: 0;\n}\n:root[data-theme=\"mallnight\"] header.top .menubar {\n  height: 24px;\n}\n:root[data-theme=\"mallnight\"] header.top::before {\n  content: \"\";\n  display: block;\n  height: 12px;\n  background: var(--mp-checker);\n}\n:root[data-theme=\"mallnight\"] header.top::after {\n  content: \"\";\n  display: block;\n  height: 14px;\n  background: #f6f1fb url(asset:mallpastel-meander) left center / 24px 14px repeat-x;\n  border-top: 1px solid var(--border-strong);\n  border-bottom: 1px solid var(--border-strong);\n}\n:root[data-theme=\"mallnight\"] :is(.menubar, .strip, footer.status) {\n  background: var(--mp-marble), #ffffff;\n  color: var(--mp-ink);\n  border-color: var(--border-strong);\n}\n:root[data-theme=\"mallnight\"] .menubar::before {\n  content: \"ＡＵＤＩＦＯＲＭ\";\n  align-self: center;\n  margin: 0 10px 0 10px;\n  font-weight: 800;\n  letter-spacing: 0.06em;\n  color: #8a2f74;\n  pointer-events: none;\n}\n:root[data-theme=\"mallnight\"] footer.status::after {\n  content: \"ショッピングモール ・ ａｅｓｔｈｅｔｉｃ\";\n  margin-left: auto;\n  padding-right: 8px;\n  font-family: var(--mp-japanese);\n  color: #6a4fb3;\n}\n:root[data-theme=\"mallnight\"] :is(.menubar .top:hover, .menubar .top.open) {\n  background: var(--accent);\n  color: #ffffff;\n}\n:root[data-theme=\"mallnight\"] .dockview-theme-altaudio {\n  --dv-group-view-background-color: #ffffff;\n  --dv-tabs-and-actions-container-background-color: #fbf7ff;\n  --dv-activegroup-visiblepanel-tab-background-color: #ffffff;\n  --dv-inactivegroup-visiblepanel-tab-background-color: #f6f1fb;\n  --dv-activegroup-hiddenpanel-tab-background-color: transparent;\n  --dv-inactivegroup-hiddenpanel-tab-background-color: transparent;\n  --dv-activegroup-visiblepanel-tab-color: #8a2f74;\n  --dv-activegroup-hiddenpanel-tab-color: var(--text-dim);\n  --dv-inactivegroup-hiddenpanel-tab-color: var(--text-dim);\n  --dv-tab-divider-color: var(--border);\n  --dv-active-sash-color: var(--mp-lavender);\n  --dv-drag-over-background-color: rgba(179, 156, 255, 0.18);\n}\n:root[data-theme=\"mallnight\"] .dockview-theme-altaudio .dv-tabs-and-actions-container {\n  background: var(--mp-marble), #fbf7ff;\n  border-bottom: 1px solid var(--border-strong);\n}\n:root[data-theme=\"mallnight\"] .dockview-theme-altaudio .dv-groupview {\n  border: 2px solid;\n  border-color: var(--mp-raised);\n  box-shadow: 1px 1px 0 #5d4b86;\n  overflow: hidden;\n}\n:root[data-theme=\"mallnight\"] .dockview-theme-altaudio .dv-tab {\n  font-weight: 700;\n}\n:root[data-theme=\"mallnight\"] .lanes {\n  background: url(asset:mallpastel-sun) right 40px top 16px / 260px 220px no-repeat;\n}\n:root[data-theme=\"mallnight\"] :is(.menubar .dropdown, .context, .dv-context-menu) {\n  background: #ffffff;\n  border: 2px solid;\n  border-color: var(--mp-raised);\n  border-radius: 0;\n  box-shadow: 1px 1px 0 #5d4b86, 5px 5px 0 rgba(140, 123, 176, 0.35);\n}\n:root[data-theme=\"mallnight\"] :is(.menubar .dropdown, .context, .dv-context-menu) :is(.sep, .dv-context-menu-separator) {\n  height: 0;\n  background: transparent;\n  border-top: 1px solid var(--border-strong);\n  border-bottom: 1px solid #ffffff;\n}\n:root[data-theme=\"mallnight\"] :is(.menubar .row.active, .context button.active, .dv-context-menu-item:hover, tr.sel, tr.selected, li.sel, li.selected, .item.sel, .item.selected, .file.sel, .file.selected, [role=\"option\"][aria-selected=\"true\"]) {\n  background: var(--accent);\n  color: #ffffff;\n}\n:root[data-theme=\"mallnight\"] :is(.dialog, [role=\"dialog\"], [role=\"alertdialog\"]) {\n  background: #ffffff;\n  border: 2px solid;\n  border-color: var(--mp-raised);\n  border-radius: 0;\n  box-shadow: 1px 1px 0 #5d4b86, 6px 6px 0 rgba(140, 123, 176, 0.3);\n}\n:root[data-theme=\"mallnight\"] :is(.dialog, [role=\"dialog\"], [role=\"alertdialog\"]) > :is(h1:first-child, header:first-child) {\n  padding: 4px 8px;\n  background: linear-gradient(90deg, #2ec4b6, var(--mp-mint) 35%, var(--mp-lavender));\n  color: #1d1236;\n}\n:root[data-theme=\"mallnight\"] :is(.dialog, [role=\"dialog\"], [role=\"alertdialog\"], .strip, .bar:has(> .transport)) :is(button, .tool) {\n  background: #f3ecff;\n  color: var(--mp-ink);\n  border: 2px solid;\n  border-color: var(--mp-raised);\n  border-radius: 0;\n}\n:root[data-theme=\"mallnight\"] :is(.dialog, [role=\"dialog\"], [role=\"alertdialog\"], .strip, .bar:has(> .transport)) :is(button, .tool):active:not(:disabled) {\n  border-color: var(--mp-sunken);\n}\n:root[data-theme=\"mallnight\"] :is(.dialog, [role=\"dialog\"], [role=\"alertdialog\"]) button.primary {\n  background: var(--mp-mint);\n  color: #1d1236;\n  outline: 1px dotted var(--mp-ink);\n  outline-offset: -5px;\n}\n:root[data-theme=\"mallnight\"] :is(.strip, .bar:has(> .transport)) :is(.tool.on, button.on, .view.on) {\n  background: var(--mp-mint);\n  color: #0f4f4a;\n  border-color: var(--mp-sunken);\n}\n:root[data-theme=\"mallnight\"] .bar:has(> .transport) .transport .tool.rec.on {\n  background: #ffd0e4;\n  color: #b0204f;\n}\n:root[data-theme=\"mallnight\"] .bar .clock {\n  background: var(--mp-ink);\n  color: var(--mp-mint);\n  border: 2px solid;\n  border-color: var(--mp-sunken);\n  border-radius: 0;\n}\n:root[data-theme=\"mallnight\"] :is(input[type=\"text\"], input[type=\"number\"], input[type=\"search\"], input:not([type]), textarea, select) {\n  background: #ffffff;\n  color: var(--mp-ink);\n  border: 2px solid;\n  border-color: var(--mp-sunken);\n  border-radius: 0;\n}\n:root[data-theme=\"mallnight\"] :is(input[type=\"checkbox\"], input[type=\"radio\"], input[type=\"range\"]) {\n  accent-color: var(--accent);\n}\n:root[data-theme=\"mallnight\"] ::selection {\n  background: var(--accent);\n  color: #ffffff;\n}\n:root[data-theme=\"mallnight\"] ::-webkit-scrollbar {\n  width: 14px;\n  height: 14px;\n}\n:root[data-theme=\"mallnight\"] ::-webkit-scrollbar-track {\n  background:\n    linear-gradient(45deg, #e4dcef 25%, transparent 25%, transparent 75%, #e4dcef 75%) 0 0 / 4px 4px,\n    linear-gradient(45deg, #e4dcef 25%, #ffffff 25%, #ffffff 75%, #e4dcef 75%) 2px 2px / 4px 4px;\n}\n:root[data-theme=\"mallnight\"] ::-webkit-scrollbar-thumb {\n  background: #ffd9ec;\n  border: 2px solid;\n  border-color: var(--mp-raised);\n}\n:root[data-theme=\"mallnight\"] :is(.levels .bar, .phase .legend .bar, .phase .track) {\n  position: relative;\n}\n:root[data-theme=\"mallnight\"] :is(.levels .bar, .phase .legend .bar, .phase .track)::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background: repeating-linear-gradient(90deg, transparent 0 6px, #ffffff 6px 7px);\n}\n:root[data-theme=\"mallnight\"] .phase .mark {\n  background: var(--playhead);\n}\n:root[data-theme=\"mallnight\"], :root[data-theme=\"mallnight\"] body, :root[data-theme=\"mallnight\"] :is(button, select, a, summary, [role=\"button\"], [role=\"menuitem\"], .dv-tab, input[type=\"checkbox\"], input[type=\"radio\"]):not(:disabled) {\n  cursor: url(asset:mallpastel-arrow) 2 1, default;\n}\n:root[data-theme=\"mallnight\"] [data-aero-cursor] {\n  cursor: url(asset:mallpastel-arrow) 2 1, default !important;\n}\n\n:root[data-theme=\"mallnight\"] {\n  color-scheme: dark;\n\n  --surface-0: #160f2b;\n  --surface-1: #1d1538;\n  --surface-2: #241a45;\n  --menu-bg: #241a45;\n  --surface-3: #2e2256;\n  --border: #3a2d66;\n  --border-strong: #6a55b8;\n\n  --text: #f1e9ff;\n  --text-dim: #c4b6e6;\n  --text-faint: #9a8ac4;\n\n  --accent: #b39cff;\n  --accent-dim: #4a3a8c;\n  --playhead: #ff7ab8;\n  --value: #7ff0d0;\n  --gutter: #120c24;\n  --danger: #ff6b9a;\n  --selected-text: #1a1033;\n\n  --lane-a: rgba(29, 21, 56, 0.78);\n  --lane-b: rgba(36, 26, 69, 0.78);\n  --lane-selected: rgba(70, 52, 130, 0.86);\n  --track-gap: #120c24;\n  --header-a: #1d1538;\n  --header-b: #221a42;\n  --clip-1: #ff8fc7;\n  --clip-2: #3fd8c8;\n  --clip-3: #b39cff;\n  --clip-4: #ffc46b;\n  --clip-5: #6fd0ff;\n  --clip-6: #ff9a7a;\n  --clip-7: #8ff0c8;\n  --clip-body-alpha: 0.26;\n  --clip-wave-tone: 0.45;\n  --clip-gloss: 0;\n\n  --font-ui: \"Nunito\", \"Source Sans 3\", \"Segoe UI\", system-ui, sans-serif;\n  --font-mono: \"Cascadia Mono\", \"Consolas\", ui-monospace, monospace;\n\n  --mp-lavender: #6a55b8;\n  --mp-mint: #2f8f7c;\n  --mp-pink: #ff8fc7;\n  --mp-ink: #f1e9ff;\n  --mp-hi: #6a55b8;\n  --mp-lo: #0b0718;\n  --mp-raised: var(--mp-hi) var(--mp-lo) var(--mp-lo) var(--mp-hi);\n  --mp-sunken: var(--mp-lo) var(--mp-hi) var(--mp-hi) var(--mp-lo);\n  --mp-marble: url(asset:mallnight-marble) 0 0 / 400px 400px;\n  --mp-checker: linear-gradient(45deg, var(--mp-lavender) 25%, transparent 25%, transparent 75%, var(--mp-lavender) 75%) 0 0 / 12px 12px,\n    linear-gradient(45deg, var(--mp-lavender) 25%, var(--mp-mint) 25%, var(--mp-mint) 75%, var(--mp-lavender) 75%) 6px 6px / 12px 12px;\n  --mp-japanese: \"MS Gothic\", \"Yu Gothic\", \"Hiragino Sans\", \"Noto Sans CJK JP\", \"Noto Sans JP\", sans-serif;\n  --mp-neon: 0 0 6px rgba(255, 143, 199, 0.85), 0 0 14px rgba(255, 143, 199, 0.45);\n\n  --spectrum-low: #120c24;\n  --spectrum-high: #ffd6f0;\n  --phase-low: #3fd8c8;\n  --phase-high: #ff8fc7;\n}\n:root[data-theme=\"mallnight\"] body {\n  background:\n    url(asset:mallnight-capital) left top / 26px 30px no-repeat,\n    url(asset:mallnight-capital) right top / 26px 30px no-repeat,\n    url(asset:mallnight-base) left bottom / 26px 24px no-repeat,\n    url(asset:mallnight-base) right bottom / 26px 24px no-repeat,\n    url(asset:mallnight-shaft) left top / 26px 12px repeat-y,\n    url(asset:mallnight-shaft) right top / 26px 12px repeat-y,\n    linear-gradient(180deg, #1b1236 0%, #2a1846 50%, #0f2a33 100%) fixed;\n}\n:root[data-theme=\"mallnight\"] header.top::after {\n  background: #1d1538 url(asset:mallnight-meander) left center / 24px 14px repeat-x;\n}\n:root[data-theme=\"mallnight\"] :is(.menubar, .strip, footer.status) {\n  background: var(--mp-marble), #241a45;\n}\n:root[data-theme=\"mallnight\"] .menubar::before {\n  color: #ffd6ec;\n  text-shadow: var(--mp-neon);\n}\n:root[data-theme=\"mallnight\"] footer.status::after {\n  content: \"ショッピングモール ・ ナイト\";\n  color: #ff9ad5;\n  text-shadow: var(--mp-neon);\n}\n:root[data-theme=\"mallnight\"] :is(.menubar .top:hover, .menubar .top.open) {\n  background: var(--accent);\n  color: var(--selected-text);\n}\n:root[data-theme=\"mallnight\"] .dockview-theme-altaudio {\n  --dv-group-view-background-color: #1d1538;\n  --dv-tabs-and-actions-container-background-color: #241a45;\n  --dv-activegroup-visiblepanel-tab-background-color: #2e2256;\n  --dv-inactivegroup-visiblepanel-tab-background-color: #241a45;\n  --dv-activegroup-visiblepanel-tab-color: #ffd6ec;\n  --dv-drag-over-background-color: rgba(179, 156, 255, 0.18);\n}\n:root[data-theme=\"mallnight\"] .dockview-theme-altaudio .dv-tabs-and-actions-container {\n  background: var(--mp-marble), #241a45;\n}\n:root[data-theme=\"mallnight\"] .dockview-theme-altaudio .dv-groupview {\n  box-shadow: 1px 1px 0 #0b0718;\n}\n:root[data-theme=\"mallnight\"] .dockview-theme-altaudio .dv-tab.dv-active-tab {\n  text-shadow: var(--mp-neon);\n}\n:root[data-theme=\"mallnight\"] .lanes {\n  background-image: url(asset:mallnight-moon);\n}\n:root[data-theme=\"mallnight\"] :is(.menubar .dropdown, .context, .dv-context-menu) {\n  background: #241a45;\n  box-shadow: 1px 1px 0 #0b0718, 5px 5px 0 rgba(0, 0, 0, 0.45);\n}\n:root[data-theme=\"mallnight\"] :is(.menubar .dropdown, .context, .dv-context-menu) :is(.sep, .dv-context-menu-separator) {\n  border-top-color: #0b0718;\n  border-bottom-color: #4a3d7a;\n}\n:root[data-theme=\"mallnight\"] :is(.menubar .row.active, .context button.active, .dv-context-menu-item:hover, tr.sel, tr.selected, li.sel, li.selected, .item.sel, .item.selected, .file.sel, .file.selected, [role=\"option\"][aria-selected=\"true\"]) {\n  background: var(--accent);\n  color: var(--selected-text);\n}\n:root[data-theme=\"mallnight\"] :is(.dialog, [role=\"dialog\"], [role=\"alertdialog\"]) {\n  background: #1d1538;\n  box-shadow: 1px 1px 0 #0b0718, 6px 6px 0 rgba(0, 0, 0, 0.45);\n}\n:root[data-theme=\"mallnight\"] :is(.dialog, [role=\"dialog\"], [role=\"alertdialog\"]) > :is(h1:first-child, header:first-child) {\n  background: linear-gradient(90deg, #1f6f66, #4a3a8c 45%, #a0457f);\n  color: #ffffff;\n}\n:root[data-theme=\"mallnight\"] :is(.dialog, [role=\"dialog\"], [role=\"alertdialog\"], .strip, .bar:has(> .transport)) :is(button, .tool) {\n  background: #2e2256;\n  color: var(--text);\n}\n:root[data-theme=\"mallnight\"] :is(.dialog, [role=\"dialog\"], [role=\"alertdialog\"]) button.primary {\n  background: #2f8f7c;\n  color: #ffffff;\n  outline-color: #ffffff;\n}\n:root[data-theme=\"mallnight\"] :is(.strip, .bar:has(> .transport)) :is(.tool.on, button.on, .view.on) {\n  background: #2f8f7c;\n  color: #ffffff;\n  box-shadow: 0 0 8px rgba(127, 240, 208, 0.5);\n}\n:root[data-theme=\"mallnight\"] .bar:has(> .transport) .transport .tool.rec.on {\n  background: #6a1f45;\n  color: #ffd6ec;\n  box-shadow: var(--mp-neon);\n}\n:root[data-theme=\"mallnight\"] .bar .clock {\n  background: #0b0718;\n  color: #9ff0d6;\n  text-shadow: 0 0 6px rgba(159, 240, 214, 0.7);\n}\n:root[data-theme=\"mallnight\"] :is(input[type=\"text\"], input[type=\"number\"], input[type=\"search\"], input:not([type]), textarea, select) {\n  background: #120c24;\n  color: var(--text);\n}\n:root[data-theme=\"mallnight\"] ::selection {\n  background: var(--accent);\n  color: var(--selected-text);\n}\n:root[data-theme=\"mallnight\"] ::-webkit-scrollbar-track {\n  background:\n    linear-gradient(45deg, #2a2150 25%, transparent 25%, transparent 75%, #2a2150 75%) 0 0 / 4px 4px,\n    linear-gradient(45deg, #2a2150 25%, #1d1538 25%, #1d1538 75%, #2a2150 75%) 2px 2px / 4px 4px;\n}\n:root[data-theme=\"mallnight\"] ::-webkit-scrollbar-thumb {\n  background: #6a2f5f;\n}\n:root[data-theme=\"mallnight\"] :is(.levels .bar, .phase .legend .bar, .phase .track)::after {\n  background: repeating-linear-gradient(90deg, transparent 0 6px, #1d1538 6px 7px);\n}\n:root[data-theme=\"mallnight\"] footer.status::after {\n  margin-left: 12px;\n}\n:root[data-theme=\"mallnight\"] footer.status .discord {\n  border: 1px solid var(--border-strong);\n  border-radius: 999px;\n  background: #fbf7ff;\n  color: #8a2f74;\n  font-weight: 700;\n  opacity: 1;\n}\n:root[data-theme=\"mallnight\"] footer.status .discord:hover {\n  background: var(--accent);\n  border-color: var(--accent);\n  color: #ffffff;\n}\n",
  "assets": {
    "mallnight-base": "data:image/svg+xml;base64,",
