{
  "format": "audiform-theme",
  "version": 1,
  "id": "phosphor",
  "name": "Phosphor",
  "base": "dark",
  "description": "An early studio computer: green screens in a beige case.",
  "author": "The Audiform contributors",
  "canvasLook": {
    "pixel": true,
    "markCursor": true
  },
  "pointers": {
    "text": {
      "asset": "phosphor-text",
      "hot": [
        7,
        10
      ]
    },
    "ew": {
      "asset": "phosphor-ew",
      "hot": [
        11,
        5
      ]
    },
    "ns": {
      "asset": "phosphor-ns",
      "hot": [
        5,
        11
      ]
    },
    "nwse": {
      "asset": "phosphor-nwse",
      "hot": [
        9,
        9
      ]
    },
    "nesw": {
      "asset": "phosphor-nesw",
      "hot": [
        9,
        9
      ]
    },
    "grab": {
      "asset": "phosphor-grab",
      "hot": [
        10,
        9
      ]
    },
    "grabbing": {
      "asset": "phosphor-grabbing",
      "hot": [
        10,
        7
      ]
    },
    "move": {
      "asset": "phosphor-move",
      "hot": [
        10,
        10
      ]
    }
  },
  "css": ":root[data-theme=\"phosphor\"] {\n  --radius-field: 0;\n  --radius-menu: 0;\n  --radius-dialog: 0;\n  color-scheme: dark;\n  --surface-0: #040a05;\n  --surface-1: #071108;\n  --surface-2: #0b1a0d;\n  --menu-bg: #0b1a0d;\n  --surface-3: #10260f;\n  --border: #1b3d1f;\n  --border-strong: #2d6a35;\n  --text: #6dff8e;\n  --text-dim: #3fc463;\n  --text-faint: #23803c;\n\n  --accent: #8dffaa;\n  --accent-dim: #2a8f45;\n  --playhead: #e6ffe9;\n  --value: #b6ffc8;\n  --gutter: #b9ad8f;\n  --danger: #ff6a3d;\n  --selected-text: #021004;\n\n  --lane-a: #061008;\n  --lane-b: #08150a;\n  --lane-selected: #10301a;\n  --track-gap: #020502;\n  --header-a: #091609;\n  --header-b: #0c1c0d;\n  --clip-1: #4dff7a;\n  --clip-2: #2fd8b0;\n  --clip-3: #a6ff4d;\n  --clip-4: #ffb84d;\n  --clip-5: #d9ff8c;\n  --clip-6: #7affd6;\n  --clip-7: #3fae5c;\n  --clip-body-alpha: 0.16;\n  --clip-wave-tone: 0.25;\n  --clip-gloss: 0;\n\n  --font-ui: \"Cascadia Mono\", \"Consolas\", \"DejaVu Sans Mono\", ui-monospace, monospace;\n  --font-mono: \"Cascadia Mono\", \"Consolas\", \"DejaVu Sans Mono\", ui-monospace, monospace;\n  --font-size: 12px;\n  --font-size-small: 11px;\n  --p-case: #d8ccaa;\n  --p-case-light: #e9e0c6;\n  --p-case-dark: #a99c7a;\n  --p-ink: #3a3020;\n  --p-ink-dim: #6b5d42;\n  --p-glow: 0 0 3px rgba(80, 255, 130, 0.55);\n  --spectrum-low: #062e12;\n  --spectrum-high: #ccffe6;\n  --phase-low: #2fae4a;\n  --phase-high: #b6ffe0;\n}\n\n:root[data-theme=\"phosphor\"] body {\n  background: var(--p-case);\n  text-shadow: var(--p-glow);\n}\n:root[data-theme=\"phosphor\"],\n:root[data-theme=\"phosphor\"] body,\n:root[data-theme=\"phosphor\"] :is(button, select, a, summary, [role=\"button\"], [role=\"menuitem\"], .dv-tab, input[type=\"checkbox\"], input[type=\"radio\"]):not(:disabled) {\n  cursor: url(asset:phosphor-arrow) 2 2, default;\n}\n:root[data-theme=\"phosphor\"] [data-aero-cursor] {\n  cursor: url(asset:phosphor-arrow) 2 2, default !important;\n}\n:root[data-theme=\"phosphor\"] body::after {\n  content: \"\";\n  position: fixed;\n  inset: 0;\n  pointer-events: none;\n  z-index: 100000;\n  background:\n    repeating-linear-gradient(rgba(0, 0, 0, 0) 0 2px, rgba(0, 0, 0, 0.13) 2px 3px),\n    radial-gradient(ellipse at center, rgba(0, 0, 0, 0) 60%, rgba(0, 0, 0, 0.18) 100%);\n  mix-blend-mode: multiply;\n}\n:root[data-theme=\"phosphor\"] :is(header.top, .menubar, .strip, footer.status) {\n  background: linear-gradient(var(--p-case-light), var(--p-case));\n  color: var(--p-ink);\n  text-shadow: none;\n  border-color: var(--p-case-dark);\n}\n:root[data-theme=\"phosphor\"] footer.status {\n  border-top: 1px solid var(--p-case-dark);\n}\n:root[data-theme=\"phosphor\"] :is(.menubar .top, footer.status *) {\n  color: var(--p-ink);\n}\n:root[data-theme=\"phosphor\"] :is(.menubar .top:hover, .menubar .top.open) {\n  background: var(--p-ink);\n  color: var(--p-case-light);\n}\n:root[data-theme=\"phosphor\"] .dockview-theme-altaudio {\n  --dv-tabs-and-actions-container-background-color: var(--p-case);\n  --dv-activegroup-hiddenpanel-tab-background-color: var(--p-case);\n  --dv-inactivegroup-hiddenpanel-tab-background-color: var(--p-case);\n  --dv-activegroup-hiddenpanel-tab-color: var(--p-ink-dim);\n  --dv-inactivegroup-hiddenpanel-tab-color: var(--p-ink-dim);\n  --dv-tab-divider-color: var(--p-case-dark);\n  --dv-active-sash-color: var(--p-case-dark);\n  --dv-drag-over-background-color: rgba(109, 255, 142, 0.14);\n}\n:root[data-theme=\"phosphor\"] .dockview-theme-altaudio .dv-groupview {\n  border: 3px solid var(--gutter);\n  border-radius: 6px;\n  box-shadow: inset 0 0 0 1px #000, inset 0 0 18px rgba(60, 255, 110, 0.06);\n  overflow: hidden;\n}\n:root[data-theme=\"phosphor\"] .dockview-theme-altaudio .dv-tab:not(.dv-active-tab) {\n  text-shadow: none;\n}\n:root[data-theme=\"phosphor\"] :is(.strip, .bar:has(> .transport)) :is(button, .tool) {\n  background: linear-gradient(var(--p-case-light), var(--p-case) 70%, var(--p-case-dark));\n  color: var(--p-ink);\n  border: 1px solid var(--p-case-dark);\n  border-bottom-width: 2px;\n  border-radius: 3px;\n  text-shadow: none;\n}\n:root[data-theme=\"phosphor\"] :is(.strip, .bar:has(> .transport)) :is(button, .tool):active:not(:disabled) {\n  border-bottom-width: 1px;\n  transform: translateY(1px);\n}\n:root[data-theme=\"phosphor\"] :is(.strip, .bar:has(> .transport)) :is(.tool.on, button.on, .view.on) {\n  background: var(--p-ink);\n  color: var(--text);\n  text-shadow: var(--p-glow);\n}\n:root[data-theme=\"phosphor\"] .bar:has(> .transport) .transport .tool.rec.on {\n  color: var(--danger);\n}\n:root[data-theme=\"phosphor\"] .bar .clock {\n  background: #020602;\n  color: var(--text);\n  border: 2px solid var(--p-case-dark);\n  border-radius: 4px;\n  text-shadow: 0 0 6px rgba(80, 255, 130, 0.8);\n}\n:root[data-theme=\"phosphor\"] :is(input[type=\"text\"], input[type=\"number\"], input[type=\"search\"], input:not([type]), textarea, select) {\n  background: #020602;\n  color: var(--text);\n  border: 1px solid var(--border-strong);\n}\n:root[data-theme=\"phosphor\"] :is(input[type=\"checkbox\"], input[type=\"radio\"], input[type=\"range\"]) {\n  accent-color: var(--text-dim);\n}\n:root[data-theme=\"phosphor\"] :is(.menubar .row.active, .context button.active, tr.sel, tr.selected, li.sel, li.selected, .item.sel, .item.selected, .file.sel, .file.selected) {\n  background: var(--text-dim);\n  color: var(--selected-text);\n  text-shadow: none;\n}\n:root[data-theme=\"phosphor\"] :is(.menubar .dropdown, .context, .dialog, [role=\"dialog\"]) {\n  border: 1px solid var(--border-strong);\n  box-shadow: 0 0 0 3px var(--p-case-dark), 0 8px 24px rgba(0, 0, 0, 0.5);\n  border-radius: 4px;\n}\n:root[data-theme=\"phosphor\"] ::selection {\n  background: var(--text-dim);\n  color: var(--selected-text);\n}\n:root[data-theme=\"phosphor\"] ::-webkit-scrollbar {\n  width: 11px;\n  height: 11px;\n}\n:root[data-theme=\"phosphor\"] ::-webkit-scrollbar-track {\n  background: #020602;\n}\n:root[data-theme=\"phosphor\"] ::-webkit-scrollbar-thumb {\n  background: var(--p-case-dark);\n  border: 2px solid #020602;\n  border-radius: 5px;\n}\n:root[data-theme=\"phosphor\"] ::-webkit-scrollbar-thumb:hover {\n  background: var(--p-case);\n}\n:root[data-theme=\"phosphor\"] *,\n:root[data-theme=\"phosphor\"] *::before,\n:root[data-theme=\"phosphor\"] *::after {\n  border-radius: 0 !important;\n}\n:root[data-theme=\"phosphor\"] :is(.levels .bar, .phase .legend .bar, .phase .track) {\n  position: relative;\n}\n:root[data-theme=\"phosphor\"] :is(.levels .bar, .phase .legend .bar, .phase .track)::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background: repeating-linear-gradient(90deg, transparent 0 4px, #020602 4px 6px);\n}\n:root[data-theme=\"phosphor\"] .phase .mark {\n  width: 6px;\n  margin-left: -3px;\n  background: var(--accent);\n  box-shadow: 0 0 4px rgba(109, 255, 142, 0.7);\n}\n:root[data-theme=\"phosphor\"] input[type=\"range\"] {\n  accent-color: var(--text);\n}\n:root[data-theme=\"phosphor\"] footer.status .discord {\n  border: 1px solid var(--p-case-dark);\n  border-radius: 1px;\n  background: linear-gradient(var(--p-case-light), var(--p-case));\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  opacity: 1;\n}\n:root[data-theme=\"phosphor\"] footer.status .discord:hover {\n  background: var(--p-ink);\n  color: var(--p-case-light);\n}\n",
  "assets": {
    "phosphor-arrow": "data:image/svg+xml;base64,",
    "phosphor-ew": "data:image/svg+xml;base64,",
    "phosphor-grab": "data:image/svg+xml;base64,",
    "phosphor-grabbing": "data:image/svg+xml;base64,",
    "phosphor-nesw": "data:image/svg+xml;base64,",
    "phosphor-ns": "data:image/svg+xml;base64,",
    "phosphor-nwse": "data:image/svg+xml;base64,",
    "phosphor-text": "data:image/svg+xml;base64,",
    "phosphor-move": "data:image/svg+xml;base64,"
  }
}
