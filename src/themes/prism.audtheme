to top, #3f8cff, #2fbfb0 30%, #3fbf5a 50%, #c8e040 calc(var(--meter-yellow, 80%) - 8%), #ffd23f var(--meter-yellow, 80%), #ff9a2f calc(var(--meter-red, 95%) - 2%), #ff3a4a);\n  box-shadow: 0 0 6px rgba(120, 200, 255, 0.25), 0 0 0 1px rgba(255, 255, 255, 0.28);\n}\n:root[data-theme=\"prism\"] :is(.levels, .meter) .cover, :root[data-theme=\"prism\"] .mcover {\n  background: linear-gradient(rgba(22, 26, 42, 0.97), rgba(10, 12, 22, 0.97));\n}\n:root[data-theme=\"prism\"] .meter .bars {\n  border-color: rgba(255, 255, 255, 0.28);\n  background: rgba(10, 12, 22, 0.6);\n}\n:root[data-theme=\"prism\"] :is(.fader .cap, .track .cap) {\n  border-color: rgba(220, 200, 255, 0.75);\n  background:\n    radial-gradient(ellipse 90% 60% at 50% 0%, rgba(240, 235, 255, 0.85), rgba(255, 255, 255, 0) 70%),\n    linear-gradient(#9a6cff, #4a2a9a);\n}\n:root[data-theme=\"prism\"] :is(.fader .slot, .track .slot) {\n  background: linear-gradient(90deg, rgba(0, 0, 10, 0.6), rgba(255, 255, 255, 0.2));\n}\n:root[data-theme=\"prism\"] .bk .pointer {\n  stroke: #ff6ad8;\n}\n:root[data-theme=\"prism\"] .bk .skirt {\n  stroke: rgba(255, 255, 255, 0.4);\n}\n:root[data-theme=\"prism\"] ::-webkit-scrollbar-thumb {\n  background: linear-gradient(#3fbf5a, #3f8cff 35%, #8f5cff 55%, #ff9a2f 80%, #ffd23f) padding-box;\n  box-shadow: none;\n}\n:root[data-theme=\"prism\"] .backdrop {\n  background: rgba(0, 0, 10, 0.4);\n}\n:root[data-theme=\"prism\"] body::before {\n  background: none;\n}\n:root[data-theme=\"prism\"] {\n  --menu-bg: #1c2030;\n}\n:root[data-theme=\"prism\"] footer.status .discord {\n  height: 17px;\n  padding: 0 10px;\n  border-radius: 999px;\n  font-size: 10px;\n  opacity: 0.9;\n}\n:root[data-theme=\"prism\"] footer.status .discord:hover {\n  opacity: 1;\n}\n",
