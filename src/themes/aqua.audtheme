{
  "format": "audiform-theme",
  "version": 1,
  "id": "aqua",
  "name": "Aqua Aero",
  "base": "light",
  "description": "Clear frosted glass over sunlit water with light rays and rising bubbles.",
  "author": "The Audiform contributors",
  "canvasLook": {
    "markCursor": true
  },
  "pointers": {
    "text": {
      "asset": "cursor-text",
      "hot": [
        10,
        10
      ]
    },
    "ew": {
      "asset": "cursor-ew",
      "hot": [
        10,
        10
      ]
    },
    "ns": {
      "asset": "cursor-ns",
      "hot": [
        10,
        10
      ]
    },
    "nwse": {
      "asset": "cursor-nwse",
      "hot": [
        10,
        10
      ]
    },
    "nesw": {
      "asset": "cursor-nesw",
      "hot": [
        10,
        10
      ]
    },
    "grab": {
      "asset": "cursor-grab",
      "hot": [
        10,
        10
      ]
    },
    "grabbing": {
      "asset": "cursor-grabbing",
      "hot": [
        10,
        10
      ]
    },
    "move": {
      "asset": "cursor-move",
      "hot": [
        10,
        10
      ]
    }
  },
  "css": ":root[data-theme=\"aqua\"] {\n  color-scheme: light;\n  --surface-0: rgba(255, 255, 255, 0.42);\n  --surface-1: rgba(255, 255, 255, 0.58);\n  --surface-2: rgba(255, 255, 255, 0.82);\n  --surface-3: rgba(255, 255, 255, 0.7);\n  --border: rgba(255, 255, 255, 0.75);\n  --border-strong: rgba(70, 150, 200, 0.45);\n\n  --text: #0b2a3a;\n  --text-dim: #2f5568;\n  --text-faint: #5f8494;\n\n  --accent: #12a7e0;\n  --accent-dim: #8fd8f5;\n  --playhead: #ff8a1a;\n  --value: #0b74b0;\n  --gutter: transparent;\n  --danger: #e2283a;\n  --selected-text: #0a3550;\n\n  --lane-a: rgba(255, 255, 255, 0.62);\n  --lane-b: rgba(255, 255, 255, 0.5);\n  --lane-selected: rgba(200, 240, 255, 0.78);\n  --track-gap: rgba(255, 255, 255, 0.25);\n  --header-a: rgba(255, 255, 255, 0.68);\n  --header-b: rgba(255, 255, 255, 0.58);\n\n  --clip-1: #2fae4a;\n  --clip-2: #1f86e0;\n  --clip-3: #7a4fd8;\n  --clip-4: #f0861f;\n  --clip-5: #d6aa10;\n  --clip-6: #e04aa8;\n  --clip-7: #10a8c8;\n  --clip-body-alpha: 0.45;\n  --clip-wave-tone: -0.35;\n  --clip-gloss: 1;\n\n  --font-ui: \"Segoe UI\", \"Frutiger\", \"Myriad Pro\", \"Source Sans 3\", system-ui, sans-serif;\n\n  --a-glass: rgba(255, 255, 255, 0.38);\n  --a-glass-strong: rgba(255, 255, 255, 0.72);\n  --a-edge: rgba(255, 255, 255, 0.85);\n  --a-shadow: rgba(0, 60, 100, 0.22);\n  --a-shine: linear-gradient(rgba(255, 255, 255, 0.75), rgba(255, 255, 255, 0.15) 50%, rgba(255, 255, 255, 0) 51%);\n  --a-pick: linear-gradient(#7fe0ff, #19aee6 52%, #0f97d2);\n  --a-go: linear-gradient(#a8f08a, #45bf3c 52%, #2fa52f);\n}\n:root[data-theme=\"aqua\"] {\n  --spectrum-low: #0a5a6e;\n  --spectrum-high: #e6f6ff;\n  --phase-low: #10b8c8;\n  --phase-high: #7a4fd8;\n}\n:root[data-theme=\"aqua\"] body {\n  background: #1a7fc0 url(asset:aqua) center / cover no-repeat fixed;\n}\n:root[data-theme=\"aqua\"] :is(header.top, main.body, .dv-dockview, .dv-grid-view, .dv-split-view-container, .dv-view-container, .dv-view) {\n  background: transparent !important;\n}\n:root[data-theme=\"aqua\"] header.top {\n  border-bottom: 0;\n}\n:root[data-theme=\"aqua\"] .dockview-theme-altaudio {\n  --dv-group-view-background-color: var(--a-glass);\n  --dv-tabs-and-actions-container-background-color: transparent;\n  --dv-activegroup-visiblepanel-tab-background-color: var(--a-glass-strong);\n  --dv-inactivegroup-visiblepanel-tab-background-color: rgba(255, 255, 255, 0.5);\n  --dv-activegroup-hiddenpanel-tab-background-color: transparent;\n  --dv-inactivegroup-hiddenpanel-tab-background-color: transparent;\n  --dv-tab-divider-color: transparent;\n  --dv-floating-box-shadow: 0 14px 36px var(--a-shadow);\n}\n:root[data-theme=\"aqua\"] .dockview-theme-altaudio .dv-groupview {\n  border: 4px solid transparent;\n  border-radius: 16px;\n  overflow: hidden;\n  background-clip: padding-box;\n  backdrop-filter: blur(18px) saturate(1.3);\n  box-shadow: 0 0 0 1px var(--a-edge) inset, 0 6px 20px var(--a-shadow);\n}\n:root[data-theme=\"aqua\"] .dockview-theme-altaudio .dv-tabs-and-actions-container {\n  border-bottom: 1px solid rgba(255, 255, 255, 0.6);\n}\n:root[data-theme=\"aqua\"] .dockview-theme-altaudio .dv-tab {\n  border-radius: 10px 10px 0 0;\n}\n:root[data-theme=\"aqua\"] :is(.menubar, .strip, footer.status) {\n  margin: 5px 8px 0;\n  border: 1px solid var(--a-edge);\n  border-radius: 14px;\n  background: var(--a-shine), var(--a-glass);\n  backdrop-filter: blur(16px) saturate(1.3);\n  box-shadow: 0 4px 14px var(--a-shadow);\n}\n:root[data-theme=\"aqua\"] .strip {\n  margin-bottom: 5px;\n}\n:root[data-theme=\"aqua\"] footer.status {\n  margin: 0 8px 5px;\n}\n:root[data-theme=\"aqua\"] :is(.editor .toolbar, .bar:has(> .transport)) {\n  background: var(--a-shine), rgba(255, 255, 255, 0.35);\n  border-color: rgba(255, 255, 255, 0.6);\n}\n:root[data-theme=\"aqua\"] :is(button, select):not(.row, .top, .tool, .context button, .view, .clock, .grab, .fold, .chev) {\n  border-radius: 8px;\n  border-color: rgba(70, 150, 200, 0.45);\n  background-image: var(--a-shine);\n  box-shadow: 0 1px 3px var(--a-shadow);\n}\n:root[data-theme=\"aqua\"] :is(button, select):not(.row, .top, .tool, .context button, .view, .clock, .grab, .fold, .chev):hover:not(:disabled) {\n  box-shadow: 0 0 0 2px rgba(120, 220, 255, 0.55), 0 2px 6px var(--a-shadow);\n}\n:root[data-theme=\"aqua\"] :is(input[type=\"text\"], input[type=\"number\"], input[type=\"search\"], input:not([type]), textarea) {\n  border-radius: 8px;\n  background-color: rgba(255, 255, 255, 0.85);\n  border-color: rgba(70, 150, 200, 0.4);\n}\n:root[data-theme=\"aqua\"] :is(input[type=\"checkbox\"], input[type=\"radio\"], input[type=\"range\"]) {\n  accent-color: #19aee6;\n}\n:root[data-theme=\"aqua\"] :is(.tool, .view) {\n  border-radius: 9px;\n}\n:root[data-theme=\"aqua\"] :is(.tool, .view):hover:not(:disabled) {\n  border-color: var(--a-edge);\n  background: var(--a-shine), rgba(255, 255, 255, 0.55);\n}\n:root[data-theme=\"aqua\"] :is(.tool.on:not(.rec, .play), .view.on, .modes button.on, .header .ms.on:not(.solo, .rec)) {\n  border-color: #0f97d2;\n  background: var(--a-pick);\n  color: #fff;\n  box-shadow: 0 0 8px rgba(40, 190, 255, 0.6);\n}\n:root[data-theme=\"aqua\"] .modes {\n  border-radius: 10px;\n  overflow: hidden;\n}\n:root[data-theme=\"aqua\"] .modes button {\n  border-radius: 0;\n  box-shadow: none;\n}\n:root[data-theme=\"aqua\"] .bar:has(> .transport) .transport .tool {\n  width: 30px;\n  height: 30px;\n  border: 1px solid var(--a-edge);\n  border-radius: 50%;\n  background: var(--a-shine), rgba(255, 255, 255, 0.55);\n  box-shadow: 0 2px 6px var(--a-shadow);\n}\n:root[data-theme=\"aqua\"] .bar:has(> .transport) .transport .tool.play.on {\n  background: var(--a-shine), var(--a-go);\n  color: #fff;\n}\n:root[data-theme=\"aqua\"] .bar:has(> .transport) .transport .tool.rec.on {\n  background: var(--a-shine), linear-gradient(#ff9a9a, #e2283a);\n  color: #fff;\n}\n:root[data-theme=\"aqua\"] .bar .clock {\n  padding: 1px 12px;\n  border: 1px solid var(--a-edge);\n  border-radius: 12px;\n  background: var(--a-shine), rgba(255, 255, 255, 0.6);\n  color: #075e8c;\n}\n:root[data-theme=\"aqua\"] .menubar .top {\n  border-radius: 8px;\n}\n:root[data-theme=\"aqua\"] :is(.menubar .top:hover, .menubar .top.open, .menubar .row.active, .context button.active) {\n  background: var(--a-pick);\n  color: #fff;\n}\n:root[data-theme=\"aqua\"] :is(.menubar .dropdown, .context) {\n  border: 1px solid var(--a-edge);\n  border-radius: 12px;\n  background: rgba(255, 255, 255, 0.78);\n  backdrop-filter: blur(18px) saturate(1.3);\n  box-shadow: 0 12px 30px var(--a-shadow);\n}\n:root[data-theme=\"aqua\"] :is(.menubar .row, .context button) {\n  border-radius: 6px;\n}\n:root[data-theme=\"aqua\"] .header.selected {\n  box-shadow: 0 0 0 1px rgba(25, 174, 230, 0.8) inset, 0 0 14px rgba(25, 174, 230, 0.3) inset;\n}\n:root[data-theme=\"aqua\"] .header .ms {\n  border-radius: 6px;\n}\n:root[data-theme=\"aqua\"] :is(.header .auto, .auto-pick) {\n  background-color: rgba(255, 255, 255, 0.8);\n  color: var(--text);\n}\n:root[data-theme=\"aqua\"] :is(tr, li, .item, .file):hover {\n  background-color: rgba(255, 255, 255, 0.45);\n}\n:root[data-theme=\"aqua\"] :is(tr, li, .item, .file):is(.sel, .selected, .on, .active) {\n  background-color: rgba(150, 225, 255, 0.6);\n}\n:root[data-theme=\"aqua\"] .backdrop {\n  background: rgba(255, 255, 255, 0.15);\n  backdrop-filter: blur(3px);\n}\n:root[data-theme=\"aqua\"] :is(.dialog, [role=\"dialog\"]) {\n  border: 1px solid var(--a-edge);\n  border-radius: 18px;\n  background: var(--a-shine), rgba(255, 255, 255, 0.72);\n  backdrop-filter: blur(22px) saturate(1.3);\n  box-shadow: 0 20px 50px var(--a-shadow);\n}\n:root[data-theme=\"aqua\"] ::-webkit-scrollbar {\n  width: 10px;\n  height: 10px;\n}\n:root[data-theme=\"aqua\"] ::-webkit-scrollbar-track {\n  background: transparent;\n}\n:root[data-theme=\"aqua\"] ::-webkit-scrollbar-thumb {\n  border: 2px solid transparent;\n  border-radius: 6px;\n  background: rgba(255, 255, 255, 0.85) padding-box;\n  box-shadow: 0 0 0 1px rgba(70, 150, 200, 0.35) inset;\n}\n:root[data-theme=\"aqua\"] :is(.levels, .meter) .cover {\n  background: #e6f3f9;\n}\n\n:root[data-theme=\"aqua\"] {\n  --surface-0: rgba(255, 255, 255, 0.16);\n  --surface-1: rgba(255, 255, 255, 0.2);\n  --surface-2: rgba(255, 255, 255, 0.62);\n  --surface-3: rgba(255, 255, 255, 0.42);\n  --lane-a: rgba(255, 255, 255, 0.34);\n  --lane-b: rgba(255, 255, 255, 0.24);\n  --lane-selected: rgba(190, 240, 255, 0.55);\n  --track-gap: rgba(255, 255, 255, 0.18);\n  --header-a: rgba(255, 255, 255, 0.4);\n  --header-b: rgba(255, 255, 255, 0.32);\n  --text: #072634;\n  --text-dim: #1f4a5c;\n  --text-faint: #3f6a7c;\n  --clip-body-alpha: 0.5;\n  --a-glass: rgba(255, 255, 255, 0.2);\n  --a-pane: linear-gradient(135deg, rgba(255, 255, 255, 0.42), rgba(255, 255, 255, 0.12) 38%, rgba(200, 240, 255, 0.08) 62%, rgba(255, 255, 255, 0.26));\n  --a-rim:\n    0 1px 0 rgba(255, 255, 255, 0.95) inset,\n    0 -1px 0 rgba(255, 255, 255, 0.35) inset,\n    0 0 0 1px rgba(255, 255, 255, 0.45) inset,\n    0 0 26px rgba(255, 255, 255, 0.28) inset;\n}\n:root[data-theme=\"aqua\"] .dockview-theme-altaudio {\n  text-shadow: 0 0 6px rgba(255, 255, 255, 0.85);\n}\n:root[data-theme=\"aqua\"] .dockview-theme-altaudio .dv-groupview {\n  position: relative;\n  background: var(--a-pane);\n  backdrop-filter: blur(26px) saturate(1.5) brightness(1.06);\n  box-shadow: var(--a-rim), 0 12px 32px rgba(0, 50, 90, 0.28);\n}\n:root[data-theme=\"aqua\"] .dockview-theme-altaudio .dv-groupview::after {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: -10%;\n  width: 120%;\n  height: 46px;\n  border-radius: 0 0 50% 50% / 0 0 100% 100%;\n  background: linear-gradient(rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.04));\n  pointer-events: none;\n  z-index: 3;\n}\n:root[data-theme=\"aqua\"] :is(.menubar, .strip, footer.status) {\n  background:\n    url(asset:droplets) repeat-x left center / auto 100%,\n    var(--a-shine),\n    var(--a-pane);\n  backdrop-filter: blur(22px) saturate(1.5) brightness(1.06);\n  box-shadow: var(--a-rim), 0 6px 18px rgba(0, 50, 90, 0.25);\n  text-shadow: 0 0 6px rgba(255, 255, 255, 0.9);\n}\n:root[data-theme=\"aqua\"] footer.status {\n  background: var(--a-shine), var(--a-pane);\n}\n:root[data-theme=\"aqua\"] :is(button, select):not(.row, .top, .tool, .context button, .view, .clock, .grab, .fold, .chev) {\n  background-color: rgba(255, 255, 255, 0.45);\n  background-image:\n    radial-gradient(ellipse 80% 55% at 50% 0%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0) 70%),\n    linear-gradient(rgba(255, 255, 255, 0) 60%, rgba(120, 200, 240, 0.25));\n  border-color: rgba(255, 255, 255, 0.85);\n  box-shadow: 0 0 0 1px rgba(60, 140, 190, 0.28), 0 2px 5px rgba(0, 50, 90, 0.22);\n}\n:root[data-theme=\"aqua\"] .bar:has(> .transport) .transport .tool {\n  background:\n    radial-gradient(circle at 35% 25%, rgba(255, 255, 255, 0.95) 0 14%, rgba(255, 255, 255, 0) 32%),\n    radial-gradient(circle at 50% 95%, rgba(120, 215, 255, 0.55), rgba(255, 255, 255, 0) 60%),\n    rgba(255, 255, 255, 0.35);\n  border-color: rgba(255, 255, 255, 0.95);\n  box-shadow: 0 0 0 1px rgba(60, 140, 190, 0.3), 0 3px 8px rgba(0, 50, 90, 0.25), 0 0 10px rgba(255, 255, 255, 0.5) inset;\n}\n:root[data-theme=\"aqua\"] .bar:has(> .transport) .transport .tool.play.on {\n  background:\n    radial-gradient(circle at 35% 25%, rgba(255, 255, 255, 0.95) 0 14%, rgba(255, 255, 255, 0) 32%),\n    radial-gradient(circle at 50% 80%, #b6f59a, #3fbf3a 75%);\n}\n:root[data-theme=\"aqua\"] .bar:has(> .transport) .transport .tool.rec.on {\n  background:\n    radial-gradient(circle at 35% 25%, rgba(255, 255, 255, 0.95) 0 14%, rgba(255, 255, 255, 0) 32%),\n    radial-gradient(circle at 50% 80%, #ffb0b0, #e2283a 75%);\n}\n:root[data-theme=\"aqua\"] .levels .bar {\n  height: 12px;\n  border-radius: 7px;\n  background: linear-gradient(to right, #3fd67a, #5fe06a 45%, #b8e64a calc(var(--meter-yellow, 80%) - 6%), #ffd23f var(--meter-yellow, 80%), #ff9a3d calc(var(--meter-red, 95%) - 2%), #ff4f6a);\n  box-shadow: 0 1px 3px rgba(0, 50, 90, 0.35) inset, 0 0 0 1px rgba(255, 255, 255, 0.8);\n}\n:root[data-theme=\"aqua\"] :is(.meter .bar, .mbar) {\n  border-radius: 4px;\n  background: linear-gradient(to top, #3fd67a, #5fe06a 45%, #b8e64a calc(var(--meter-yellow, 80%) - 6%), #ffd23f var(--meter-yellow, 80%), #ff9a3d calc(var(--meter-red, 95%) - 2%), #ff4f6a);\n  box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.7);\n}\n:root[data-theme=\"aqua\"] .mbar {\n  background: linear-gradient(to top, #3fd67a, #5fe06a 30%, #b8e64a 47%, #ffd23f 53%, #ff9a3d 74%, #ff4f6a);\n}\n:root[data-theme=\"aqua\"] :is(.levels, .meter) .cover, :root[data-theme=\"aqua\"] .mcover {\n  z-index: 1;\n  background: linear-gradient(rgba(244, 251, 255, 0.97), rgba(214, 236, 247, 0.97));\n}\n:root[data-theme=\"aqua\"] .levels .bar::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  z-index: 2;\n  border-radius: inherit;\n  background: linear-gradient(rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.15) 48%, rgba(255, 255, 255, 0) 52%, rgba(255, 255, 255, 0.3));\n  pointer-events: none;\n}\n:root[data-theme=\"aqua\"] :is(.meter .bar, .mbar)::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  z-index: 2;\n  border-radius: inherit;\n  background: linear-gradient(90deg, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.1) 50%, rgba(255, 255, 255, 0.25));\n  pointer-events: none;\n}\n:root[data-theme=\"aqua\"] :is(.levels .peak, .meter .peak, .mpeak) {\n  z-index: 3;\n  background: #ffffff;\n  box-shadow: 0 0 4px rgba(255, 255, 255, 0.9), 0 0 2px rgba(0, 80, 130, 0.6);\n}\n:root[data-theme=\"aqua\"] :is(.levels .over, .meter .over) {\n  border-radius: 50%;\n  border-color: rgba(255, 255, 255, 0.9);\n  background: radial-gradient(circle at 35% 30%, #fff, rgba(255, 255, 255, 0.4) 60%);\n}\n:root[data-theme=\"aqua\"] .meter .bars {\n  border-radius: 6px;\n  border-color: rgba(255, 255, 255, 0.8);\n  background: rgba(255, 255, 255, 0.3);\n}\n:root[data-theme=\"aqua\"] .fader .slot, :root[data-theme=\"aqua\"] .track .slot {\n  border-radius: 3px;\n  background: linear-gradient(90deg, rgba(0, 60, 100, 0.25), rgba(255, 255, 255, 0.6));\n}\n:root[data-theme=\"aqua\"] :is(.fader .cap, .track .cap) {\n  border-color: rgba(255, 255, 255, 0.95);\n  border-radius: 6px;\n  background:\n    radial-gradient(ellipse 90% 60% at 50% 0%, #fff, rgba(255, 255, 255, 0) 70%),\n    linear-gradient(#e9f8ff, #9fdcf6);\n  box-shadow: 0 0 0 1px rgba(40, 130, 180, 0.4), 0 2px 5px rgba(0, 50, 90, 0.3);\n}\n:root[data-theme=\"aqua\"] .strip {\n  background: var(--a-pane);\n  border-color: rgba(255, 255, 255, 0.6);\n  border-radius: 10px;\n  box-shadow: var(--a-rim);\n}\n:root[data-theme=\"aqua\"] .knob .body {\n  fill: url(#glass-orb);\n  stroke: rgba(255, 255, 255, 0.95);\n}\n:root[data-theme=\"aqua\"] .bk .skirt {\n  fill: url(#glass-skirt);\n  stroke: rgba(255, 255, 255, 0.95);\n}\n:root[data-theme=\"aqua\"] .bk .cap {\n  fill: url(#glass-orb);\n  stroke: rgba(40, 130, 180, 0.4);\n}\n:root[data-theme=\"aqua\"] .bk .grip {\n  stroke: rgba(40, 110, 160, 0.4);\n}\n:root[data-theme=\"aqua\"] .bk .pointer {\n  stroke: #0f8fd0;\n}\n:root[data-theme=\"aqua\"] .dial .knob circle:first-child {\n  fill: url(#glass-orb);\n}\n:root[data-theme=\"aqua\"] :is(.dialog, [role=\"dialog\"], .menubar .dropdown, .context) {\n  background: var(--a-shine), linear-gradient(135deg, rgba(255, 255, 255, 0.78), rgba(235, 248, 255, 0.62));\n  backdrop-filter: blur(28px) saturate(1.5);\n  box-shadow: var(--a-rim), 0 18px 44px rgba(0, 50, 90, 0.32);\n}\n:root[data-theme=\"aqua\"] body::before {\n  content: \"\";\n  position: fixed;\n  inset: 0;\n  pointer-events: none;\n  background:\n    radial-gradient(circle at 6% 92%, rgba(255, 255, 255, 0.55) 0 0.6%, rgba(255, 255, 255, 0) 0.9%),\n    radial-gradient(circle at 97% 60%, rgba(255, 255, 255, 0.5) 0 0.4%, rgba(255, 255, 255, 0) 0.7%),\n    radial-gradient(circle at 52% 98%, rgba(255, 255, 255, 0.45) 0 0.5%, rgba(255, 255, 255, 0) 0.8%);\n}\n:root[data-theme=\"aqua\"] header.top {\n  position: relative;\n  z-index: 50;\n}\n:root[data-theme=\"aqua\"] .menubar {\n  backdrop-filter: none !important;\n}\n:root[data-theme=\"aqua\"] .menubar {\n  background:\n    url(asset:droplets) repeat-x left center / auto 100%,\n    var(--a-shine),\n    linear-gradient(135deg, rgba(255, 255, 255, 0.72), rgba(235, 248, 255, 0.55));\n}\n:root[data-theme=\"aqua\"] :is(.menubar .dropdown, .context) {\n  background: var(--a-shine), linear-gradient(135deg, rgba(255, 255, 255, 0.62), rgba(230, 246, 255, 0.48));\n  backdrop-filter: blur(22px) saturate(1.6) brightness(1.08);\n}\n:root[data-theme=\"aqua\"], :root[data-theme=\"aqua\"] body, :root[data-theme=\"aqua\"] :is(button, select, a, summary, [role=\"button\"], [role=\"menuitem\"], .dv-tab, input[type=\"checkbox\"], input[type=\"radio\"]):not(:disabled) {\n  cursor: url(asset:cursor) 3 2, default;\n}\n:root[data-theme=\"aqua\"] [data-aero-cursor] {\n  cursor: url(asset:cursor) 3 2, default !important;\n}\n:root[data-theme=\"aqua\"] {\n  --menu-bg: #eef7fd;\n}\n:root[data-theme=\"aqua\"] .vf {\n  background: rgba(255, 255, 255, 0.72);\n  border-color: rgba(70, 150, 200, 0.45);\n  color: var(--value);\n}\n:root[data-theme=\"aqua\"] footer.status .discord {\n  height: 17px;\n  padding: 0 10px;\n  border-radius: 999px;\n  font-size: 10px;\n  opacity: 0.9;\n}\n:root[data-theme=\"aqua\"] footer.status .discord:hover {\n  opacity: 1;\n}\n\n\n/* Panes paint a copy of the scene blurred once (scripts/themes/make-glass-blur.py) instead of a live backdrop blur, which is redone whenever the playhead or meters repaint. */\n:root[data-theme=\"aqua\"] .dockview-theme-altaudio .dv-groupview {\n  background: var(--a-pane), url(asset:aqua-glass) center / cover no-repeat fixed;\n  backdrop-filter: none;\n}\n",
  "assets": {
    "aqua": "data:image/webp;base64,",
    "cursor-ew": "data:image/svg+xml;base64,",
    "cursor-grab": "data:image/svg+xml;base64,",
    "cursor-grabbing": "data:image/svg+xml;base64,",
    "cursor-nesw": "data:image/svg+xml;base64,",
    "cursor-ns": "data:image/svg+xml;base64,",
    "cursor-nwse": "data:image/svg+xml;base64,",
    "cursor-text": "data:image/svg+xml;base64,",
    "cursor": "data:image/svg+xml;base64,",
    "droplets": "data:image/png;base64,",
    "cursor-move": "data:image/svg+xml;base64,",
    "aqua-glass": "data:image/webp;base64,"
  }
}
