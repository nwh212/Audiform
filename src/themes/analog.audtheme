{
  "format": "audiform-theme",
  "version": 1,
  "id": "analog",
  "name": "Analog",
  "base": "dark",
  "description": "A walnut and brushed metal studio desk.",
  "author": "The Audiform contributors",
  "canvasLook": {},
  "css": ":root[data-theme=\"analog\"] {\n  color-scheme: dark;\n  --surface-0: #0c0c0d;\n  --surface-1: #121213;\n  --surface-2: #171718;\n  --menu-bg: #1b1b1c;\n  --surface-3: #212123;\n  --border: #29292b;\n  --border-strong: #3d3d40;\n  --text: #ece4d2;\n  --text-dim: #b3aa96;\n  --text-faint: #7d7668;\n  --accent: #ffb547;\n  --accent-dim: #9a6420;\n  --playhead: #ff5a36;\n  --value: #ffc977;\n  --gutter: #3a2416;\n  --danger: #ff4b3a;\n  --selected-text: #1a1206;\n\n  --lane-a: #121213;\n  --lane-b: #161617;\n  --lane-selected: #2a2620;\n  --track-gap: #070708;\n  --header-a: #19191a;\n  --header-b: #1e1e20;\n  --clip-1: #d9c79a;\n  --clip-2: #a33a32;\n  --clip-3: #d1a03a;\n  --clip-4: #7f8a3f;\n  --clip-5: #3f8a86;\n  --clip-6: #c2632f;\n  --clip-7: #5f7891;\n  --clip-body-alpha: 0.22;\n  --clip-wave-tone: 0.55;\n  --clip-gloss: 0;\n\n  --font-ui: \"Bahnschrift\", \"DIN Alternate\", \"Arial Narrow\", \"Roboto Condensed\", system-ui, sans-serif;\n  --font-mono: \"Cascadia Mono\", \"Consolas\", ui-monospace, monospace;\n  --a-alu-1: #d7d6d0;\n  --a-alu-2: #b9b8b1;\n  --a-alu-3: #9b9a93;\n  --a-engrave: #2b2a26;\n  --a-walnut-1: #4a2c1a;\n  --a-walnut-2: #5e3a22;\n  --a-walnut-3: #3a2214;\n  --a-screw: radial-gradient(circle at 40% 35%, #e8e6df 0 1.2px, #9d9b93 2px, #55534c 3.2px, transparent 3.8px);\n  --a-lamp: 0 0 6px rgba(255, 181, 71, 0.75), 0 0 1px rgba(255, 220, 160, 0.9);\n\n  --spectrum-low: #1d0f08;\n  --spectrum-high: #ffe3a8;\n  --phase-low: #d18a2c;\n  --phase-high: #fff0c8;\n}\n:root[data-theme=\"analog\"] {\n  --a-walnut:\n    /* A satin oil finish: soft light across the boards. */\n    linear-gradient(180deg, rgba(255, 220, 180, 0.08), rgba(0, 0, 0, 0) 35%, rgba(0, 0, 0, 0.16)) fixed,\n    url(asset:walnut) 0 0 / 900px 420px fixed,\n    #4a2a18;\n}\n:root[data-theme=\"analog\"] body,\n:root[data-theme=\"analog\"] .dockview-theme-altaudio {\n  background: var(--a-walnut);\n}\n:root[data-theme=\"analog\"] .dockview-theme-altaudio :is(.dv-split-view-container, .dv-view-container, .dv-view, .dv-sash-container, .dv-grid-view, .dv-dockview, .dv-branch-node) {\n  background: transparent;\n}\n:root[data-theme=\"analog\"] :is(header.top, .menubar, .strip, footer.status) {\n  background:\n    /* Sheen: brushed metal throws soft bands of light across the grain. */\n    linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.22) 18%, rgba(255, 255, 255, 0) 34%, rgba(0, 0, 0, 0.06) 52%, rgba(255, 255, 255, 0.16) 71%, rgba(255, 255, 255, 0) 88%),\n    linear-gradient(rgba(255, 255, 255, 0.25), rgba(255, 255, 255, 0) 40%, rgba(0, 0, 0, 0.12)),\n    url(asset:brushed) 0 0 / 1200px 120px,\n    var(--a-alu-2);\n  color: var(--a-engrave);\n  border-color: #6f6e68;\n}\n:root[data-theme=\"analog\"] :is(.menubar .top, footer.status *) {\n  color: var(--a-engrave);\n  text-shadow: 0 1px 0 rgba(255, 255, 255, 0.5);\n}\n:root[data-theme=\"analog\"] .menubar .top {\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  font-size: 11px;\n}\n:root[data-theme=\"analog\"] :is(.menubar .top:hover, .menubar .top.open) {\n  background: var(--a-engrave);\n  color: var(--accent);\n  text-shadow: none;\n}\n:root[data-theme=\"analog\"] .dockview-theme-altaudio {\n  --dv-tabs-and-actions-container-background-color: #1a1a18;\n  --dv-activegroup-visiblepanel-tab-background-color: var(--surface-2);\n  --dv-inactivegroup-visiblepanel-tab-background-color: #1f1f1c;\n  --dv-activegroup-hiddenpanel-tab-background-color: #1a1a18;\n  --dv-inactivegroup-hiddenpanel-tab-background-color: #1a1a18;\n  --dv-activegroup-visiblepanel-tab-color: var(--accent);\n  --dv-activegroup-hiddenpanel-tab-color: var(--text-faint);\n  --dv-inactivegroup-hiddenpanel-tab-color: var(--text-faint);\n  --dv-tab-divider-color: #0d0d0c;\n  --dv-active-sash-color: var(--accent-dim);\n  --dv-drag-over-background-color: rgba(255, 181, 71, 0.12);\n}\n:root[data-theme=\"analog\"] .dockview-theme-altaudio .dv-tab {\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  font-size: 11px;\n}\n:root[data-theme=\"analog\"] .dockview-theme-altaudio .dv-groupview {\n  position: relative;\n  border: 7px solid transparent;\n  background-clip: padding-box;\n  box-shadow:\n    inset 0 1px 0 rgba(255, 255, 255, 0.06),\n    inset 0 0 0 1px #000,\n    inset 0 0 0 4px #141415,\n    0 2px 8px rgba(0, 0, 0, 0.6);\n  overflow: hidden;\n}\n:root[data-theme=\"analog\"] .dockview-theme-altaudio .dv-groupview::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  z-index: 5;\n  background:\n    var(--a-screw) left 3px top 3px / 9px 9px no-repeat,\n    var(--a-screw) right 3px top 3px / 9px 9px no-repeat,\n    var(--a-screw) left 3px bottom 3px / 9px 9px no-repeat,\n    var(--a-screw) right 3px bottom 3px / 9px 9px no-repeat;\n}\n:root[data-theme=\"analog\"] .dockview-theme-altaudio .dv-tabs-and-actions-container {\n  padding: 0 13px;\n  background:\n    repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.025) 0 1px, transparent 1px 2px),\n    #1a1a18;\n}\n:root[data-theme=\"analog\"] :is(.strip, .bar:has(> .transport)) :is(button, .tool) {\n  background: linear-gradient(#3c3b37, #2a2926 60%, #1f1e1b);\n  color: var(--text);\n  border: 1px solid #0c0c0b;\n  border-bottom-width: 3px;\n  border-radius: 3px;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);\n}\n:root[data-theme=\"analog\"] :is(.strip, .bar:has(> .transport)) :is(button, .tool):active:not(:disabled) {\n  border-bottom-width: 1px;\n  transform: translateY(2px);\n}\n:root[data-theme=\"analog\"] :is(.strip, .bar:has(> .transport)) :is(.tool.on, button.on, .view.on) {\n  background: linear-gradient(#ffcf7a, #ffb547 55%, #d98a1e);\n  color: #2a1a04;\n  box-shadow: var(--a-lamp), inset 0 1px 0 rgba(255, 255, 255, 0.5);\n}\n:root[data-theme=\"analog\"] .bar:has(> .transport) .transport .tool.rec.on {\n  background: linear-gradient(#ff8a70, #ff4b3a 55%, #b8261a);\n  color: #2a0704;\n  box-shadow: 0 0 8px rgba(255, 75, 58, 0.8);\n}\n:root[data-theme=\"analog\"] .bar .clock {\n  background: linear-gradient(#120804, #1d0d05);\n  color: #ff9c3a;\n  border: 2px solid #0a0a09;\n  border-radius: 4px;\n  box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.8), 0 1px 0 rgba(255, 255, 255, 0.08);\n  text-shadow: 0 0 6px rgba(255, 140, 40, 0.9), 0 0 14px rgba(255, 110, 20, 0.45);\n  letter-spacing: 0.06em;\n}\n:root[data-theme=\"analog\"] :is(input[type=\"text\"], input[type=\"number\"], input[type=\"search\"], input:not([type]), textarea, select) {\n  background: #121210;\n  color: var(--text);\n  border: 1px solid #0a0a09;\n  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.7);\n  border-radius: 2px;\n}\n:root[data-theme=\"analog\"] :is(input[type=\"checkbox\"], input[type=\"radio\"], input[type=\"range\"]) {\n  accent-color: var(--accent);\n}\n:root[data-theme=\"analog\"] :is(.menubar .row.active, .context button.active, tr.sel, tr.selected, li.sel, li.selected, .item.sel, .item.selected, .file.sel, .file.selected) {\n  background: var(--accent);\n  color: var(--selected-text);\n}\n:root[data-theme=\"analog\"] :is(.menubar .dropdown, .context) {\n  background: #242421;\n  border: 1px solid #0b0b0a;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 8px 24px rgba(0, 0, 0, 0.6);\n}\n:root[data-theme=\"analog\"] :is(.dialog, [role=\"dialog\"]) {\n  border: 1px solid #0b0b0a;\n  box-shadow: 0 0 0 4px #2b2a26, 0 0 0 5px #0b0b0a, 0 12px 32px rgba(0, 0, 0, 0.6);\n}\n:root[data-theme=\"analog\"] ::selection {\n  background: var(--accent);\n  color: var(--selected-text);\n}\n:root[data-theme=\"analog\"] ::-webkit-scrollbar {\n  width: 12px;\n  height: 12px;\n}\n:root[data-theme=\"analog\"] ::-webkit-scrollbar-track {\n  background: #0f0f0e;\n  box-shadow: inset 0 0 3px rgba(0, 0, 0, 0.9);\n}\n:root[data-theme=\"analog\"] ::-webkit-scrollbar-thumb {\n  background: linear-gradient(90deg, var(--a-alu-3), var(--a-alu-1) 45%, var(--a-alu-2));\n  border: 2px solid #0f0f0e;\n  border-radius: 3px;\n}\n:root[data-theme=\"analog\"] ::-webkit-scrollbar-thumb:horizontal {\n  background: linear-gradient(var(--a-alu-1), var(--a-alu-2) 55%, var(--a-alu-3));\n}\n:root[data-theme=\"analog\"] :is(.levels .bar, .phase .legend .bar, .phase .track) {\n  position: relative;\n}\n:root[data-theme=\"analog\"] :is(.levels .bar, .phase .legend .bar, .phase .track)::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background: repeating-linear-gradient(90deg, transparent 0 5px, rgba(10, 10, 9, 0.9) 5px 7px);\n}\n:root[data-theme=\"analog\"] .phase .mark {\n  background: var(--accent);\n  box-shadow: var(--a-lamp);\n}\n:root[data-theme=\"analog\"] .bar .transport .tool {\n  --cap: 200, 205, 210;\n  position: relative;\n  background:\n    linear-gradient(180deg, rgba(255, 255, 255, 0.38), rgba(255, 255, 255, 0.04) 45%, rgba(0, 0, 0, 0.18)),\n    rgba(var(--cap), 0.28);\n  color: rgb(var(--cap));\n  border: 1px solid rgba(var(--cap), 0.55);\n  border-bottom: 3px solid rgba(0, 0, 0, 0.6);\n  border-radius: 4px;\n  box-shadow:\n    inset 0 0 6px rgba(var(--cap), 0.25),\n    inset 0 1px 0 rgba(255, 255, 255, 0.45),\n    0 1px 2px rgba(0, 0, 0, 0.6);\n  text-shadow: none;\n  transition: box-shadow 0.08s, background 0.08s, color 0.08s;\n}\n:root[data-theme=\"analog\"] .bar .transport .tool[aria-label=\"Stop\"] {\n  --cap: 225, 228, 232;\n}\n:root[data-theme=\"analog\"] .bar .transport .tool.play {\n  --cap: 70, 220, 110;\n}\n:root[data-theme=\"analog\"] .bar .transport .tool:is([aria-label=\"Go to start\"], [aria-label=\"Go to end\"], [aria-label=\"Rewind\"], [aria-label=\"Fast forward\"]) {\n  --cap: 90, 170, 255;\n}\n:root[data-theme=\"analog\"] .bar .transport .tool.rec {\n  --cap: 255, 70, 55;\n}\n:root[data-theme=\"analog\"] .bar .transport .tool:is([aria-label=\"Loop playback\"], [aria-label=\"Skip selection\"]) {\n  --cap: 255, 180, 60;\n}\n:root[data-theme=\"analog\"] .bar .transport .tool:is(:active:not(:disabled), .on), :root[data-theme=\"analog\"] .bar .transport .tool.rec.on {\n  background:\n    radial-gradient(ellipse at 50% 60%, rgba(255, 255, 255, 0.75), rgba(var(--cap), 0.9) 55%, rgba(var(--cap), 0.65)),\n    rgb(var(--cap));\n  color: #fff;\n  border-color: rgba(var(--cap), 0.9);\n  box-shadow:\n    0 0 10px rgba(var(--cap), 0.85),\n    0 0 22px rgba(var(--cap), 0.45),\n    inset 0 1px 0 rgba(255, 255, 255, 0.7);\n  text-shadow: 0 0 4px rgba(255, 255, 255, 0.9);\n}\n:root[data-theme=\"analog\"] .bar .transport .tool:active:not(:disabled) {\n  border-bottom-width: 1px;\n  transform: translateY(2px);\n}\n:root[data-theme=\"analog\"] .dockview-theme-altaudio .dv-groupview::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  z-index: 4;\n  background:\n    linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0) 30%),\n    url(asset:matte) 0 0 / 160px 160px;\n  opacity: 0.55;\n  mix-blend-mode: soft-light;\n}\n:root[data-theme=\"analog\"] :is(.strip, .bar:has(> .transport)) :is(button, .tool):not(.transport .tool) {\n  background:\n    url(asset:matte) 0 0 / 160px 160px,\n    linear-gradient(#2a2a2c, #19191b 60%, #121214);\n  background-blend-mode: soft-light, normal;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 1px 1px rgba(0, 0, 0, 0.6);\n}\n:root[data-theme=\"analog\"] :is(.strip, .bar:has(> .transport)) :is(.tool.on, button.on, .view.on):not(.transport .tool) {\n  background: linear-gradient(#ffcf7a, #ffb547 55%, #d98a1e);\n  box-shadow: var(--a-lamp), inset 0 1px 0 rgba(255, 255, 255, 0.5);\n}\n:root[data-theme=\"analog\"] footer.status .discord {\n  border: 1px solid #8d8b84;\n  border-radius: 2px;\n  background: linear-gradient(rgba(255, 255, 255, 0.35), rgba(0, 0, 0, 0.08));\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  font-size: 9px;\n  opacity: 1;\n}\n:root[data-theme=\"analog\"] footer.status .discord:hover {\n  border-color: var(--a-engrave);\n  background: linear-gradient(rgba(0, 0, 0, 0.08), rgba(255, 255, 255, 0.3));\n}\n",
  "assets": {
    "brushed": "data:image/svg+xml;base64,",
    "matte": "data:image/svg+xml;base64,",
    "walnut": "data:image/svg+xml;base64,"
  }
}
