{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session",
  "description": "A multitrack session.",
  "type": "object",
  "properties": {
    "bit_depth": {
      "description": "Mixing bit depth: 16, 24, or 32 (float).",
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "buses": {
      "description": "Bus tracks, top to bottom.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Bus"
      }
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "format": {
      "description": "Always `altaudio.session`.",
      "type": "string",
      "const": "altaudio.session"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "libraries": {
      "description": "Library folders attached to this session.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "markers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Marker"
      }
    },
    "master": {
      "$ref": "#/$defs/MasterTrack"
    },
    "media": {
      "description": "Audio files used by clips in this session.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/MediaRef"
      }
    },
    "metadata": {
      "description": "Scaffolding (P6, P7): episode metadata for show sync and export.",
      "$ref": "#/$defs/EpisodeMetadata"
    },
    "modes": {
      "description": "Podcast mode and Voiceover mode toggles, saved per session.",
      "$ref": "#/$defs/SessionModes"
    },
    "modified": {
      "type": "string",
      "format": "date-time"
    },
    "name": {
      "type": "string"
    },
    "playlist": {
      "description": "Playlist panel: range markers in the order they play and export.",
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "sample_rate": {
      "description": "Session sample rate in Hz, for example 48000.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "schema_version": {
      "description": "Version of this file format.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "space": {
      "description": "3D Space sessions: the speaker layout the mix is placed onto, each\ntrack and bus at a spot in the room instead of a pan. None for an\nordinary stereo (or mono) session.",
      "anyOf": [
        {
          "$ref": "#/$defs/Space"
        },
        {
          "type": "null"
        }
      ]
    },
    "template_id": {
      "description": "Template this session was created from, if any.",
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "tempo": {
      "description": "Tempo and meter. MIDI clips and notes are placed in beats, so they\nfollow it. Files from before MIDI tracks get the default.",
      "$ref": "#/$defs/Tempo"
    },
    "tracks": {
      "description": "Audio tracks, top to bottom.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Track"
      }
    },
    "view": {
      "description": "Where the user left off in the editor.",
      "$ref": "#/$defs/SessionView"
    }
  },
  "required": [
    "format",
    "schema_version",
    "id",
    "name",
    "sample_rate",
    "bit_depth",
    "created",
    "modified",
    "media",
    "tracks",
    "buses",
    "master",
    "markers",
    "view",
    "modes",
    "libraries",
    "metadata"
  ],
  "$defs": {
    "AudioType": {
      "description": "What a clip holds.",
      "type": "string",
      "enum": [
        "dialogue",
        "music",
        "sfx",
        "ambience"
      ]
    },
    "Bus": {
      "description": "A bus track. Tracks and other buses output or send to it; it runs\nits own Voice Chain and fader on the sum, then outputs to the master\nor another bus. A bus has no clips and no inputs of its own.",
      "type": "object",
      "properties": {
        "channels": {
          "$ref": "#/$defs/ChannelLayout"
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "effects": {
          "$ref": "#/$defs/EffectChain"
        },
        "envelopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Envelope"
          }
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "mono": {
          "description": "Folds the bus's left and right into one centered signal, after its\nVoice Chain and before its fader and pan. Left out of the file when off.",
          "type": "boolean"
        },
        "muted": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/Output"
        },
        "pan": {
          "type": "number",
          "format": "double"
        },
        "position": {
          "description": "Where the bus shows among the tracks in the Editor: below this many\ntracks (0 is above the first). None, or more than there are\ntracks, shows it below the last track. Display only.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "sends": {
          "description": "Aux sends to other buses.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Send"
          }
        },
        "solo": {
          "type": "boolean"
        },
        "space": {
          "description": "3D Space sessions: where the bus sits in the room, when it feeds\nthe master (in place of its pan).",
          "anyOf": [
            {
              "$ref": "#/$defs/SpacePos"
            },
            {
              "type": "null"
            }
          ]
        },
        "volume_db": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "id",
        "name",
        "channels",
        "height",
        "volume_db",
        "pan",
        "muted",
        "solo",
        "output",
        "sends",
        "effects",
        "envelopes"
      ]
    },
    "ChannelLayout": {
      "description": "Mono or stereo. More layouts can be added without a version bump.",
      "type": "string",
      "enum": [
        "mono",
        "stereo"
      ]
    },
    "ChannelMix": {
      "description": "A clip's Source Channels: one entry per channel of its file, in file order.",
      "type": "object",
      "properties": {
        "sends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChannelSend"
          }
        },
        "to_speakers": {
          "description": "3D Space sessions: each channel plays straight from its own speaker\n(by its name: L, R, C, LFE, Ls...) instead of through `sends`.",
          "type": "boolean"
        }
      },
      "required": [
        "sends"
      ]
    },
    "ChannelSend": {
      "description": "How much of one source channel goes to each side, from -1 to 1\n(1 is all of it; negative flips its polarity).",
      "type": "object",
      "properties": {
        "left": {
          "type": "number",
          "format": "float"
        },
        "right": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "left",
        "right"
      ]
    },
    "ChapterInfo": {
      "description": "Scaffolding (P7): extra data for chapter markers.",
      "type": "object",
      "properties": {
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Clip": {
      "description": "A non-destructive reference to part of a media file, placed on a\ntrack.",
      "type": "object",
      "properties": {
        "audio_type": {
          "description": "What the clip is: dialogue, music, sound effects or ambience.\nUsed to select clips by kind, and later by the Audio FX Panel.",
          "anyOf": [
            {
              "$ref": "#/$defs/AudioType"
            },
            {
              "type": "null"
            }
          ]
        },
        "channel_mix": {
          "description": "Source Channels: how much of each of the file's channels goes to the\nleft and right. None uses the default for the file's channels.",
          "anyOf": [
            {
              "$ref": "#/$defs/ChannelMix"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "description": "Clip color as `#rrggbb`. None uses the track color.",
          "type": [
            "string",
            "null"
          ]
        },
        "effects": {
          "description": "Clip Voice Chain.",
          "$ref": "#/$defs/EffectChain"
        },
        "envelopes": {
          "description": "Clip automation lanes.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Envelope"
          }
        },
        "fade_in": {
          "$ref": "#/$defs/Fade"
        },
        "fade_out": {
          "$ref": "#/$defs/Fade"
        },
        "gain_db": {
          "type": "number",
          "format": "double"
        },
        "group": {
          "description": "Clips with the same group id are selected and moved together.",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "locked": {
          "description": "Locked in time: the clip cannot be moved.",
          "type": "boolean"
        },
        "looped": {
          "description": "Loop Clip: the source region from `source_in` to `source_out`\nrepeats to fill the clip. None plays the region once.",
          "anyOf": [
            {
              "$ref": "#/$defs/ClipLoop"
            },
            {
              "type": "null"
            }
          ]
        },
        "media_id": {
          "description": "The media file this clip plays.",
          "type": "string",
          "format": "uuid"
        },
        "muted": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "source_in": {
          "description": "First source sample played, at the source file's rate.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "source_out": {
          "description": "Source sample after the last one played (exclusive).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "start": {
          "description": "Timeline position of the clip's left edge, in session samples.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "stretch": {
          "description": "Time stretch: the source region plays over `ratio` times its\nnatural length. Ignored while the clip loops.",
          "anyOf": [
            {
              "$ref": "#/$defs/ClipStretch"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "media_id",
        "start",
        "source_in",
        "source_out",
        "gain_db",
        "muted",
        "locked",
        "fade_in",
        "fade_out",
        "envelopes",
        "effects"
      ]
    },
    "ClipLoop": {
      "description": "How a looped clip repeats its source region.",
      "type": "object",
      "properties": {
        "length": {
          "description": "Length of the clip on the timeline, in session samples.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "phase": {
          "description": "Where in the region the clip's left edge falls, in source\nsamples from `source_in`. Splits and left trims move it.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "length",
        "phase"
      ]
    },
    "ClipStretch": {
      "description": "How a stretched (or pitch-shifted) clip plays.",
      "type": "object",
      "properties": {
        "advanced": {
          "description": "Finer settings, when set.",
          "anyOf": [
            {
              "$ref": "#/$defs/StretchAdvanced"
            },
            {
              "type": "null"
            }
          ]
        },
        "keep_pitch": {
          "description": "True keeps the pitch (for speech and ad fitting); false changes\npitch with speed, like a tape running faster or slower (varispeed).",
          "type": "boolean"
        },
        "pitch": {
          "description": "Pitch change in semitones, -24 to +24, independent of the stretch.\nOnly while the pitch is kept (varispeed sets pitch by speed).",
          "type": "number",
          "format": "double"
        },
        "polyphonic": {
          "description": "For music and other material with several notes at once: longer\nanalysis frames. False suits a single voice or instrument.",
          "type": "boolean"
        },
        "ratio": {
          "description": "Timeline length over natural length: 1.25 plays 25 percent longer.",
          "type": "number",
          "format": "double"
        },
        "rendered": {
          "description": "The user asked for the stretch to be worked out ahead (rendered)\nrather than live. Playback and export sound the same either way;\nkept so files from other editors round-trip.",
          "type": "boolean"
        }
      },
      "required": [
        "ratio",
        "keep_pitch"
      ]
    },
    "EffectChain": {
      "description": "A Voice Chain: an ordered list of effect slots on a clip, track,\nbus, or the master.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Chain power. Off bypasses every slot.",
          "type": "boolean"
        },
        "input_gain_db": {
          "type": "number",
          "format": "double"
        },
        "mix": {
          "description": "Dry/wet mix from 0.0 (dry) to 1.0 (wet).",
          "type": "number",
          "format": "double"
        },
        "output_gain_db": {
          "type": "number",
          "format": "double"
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EffectSlot"
          }
        }
      },
      "required": [
        "enabled",
        "input_gain_db",
        "output_gain_db",
        "mix",
        "slots"
      ]
    },
    "EffectSlot": {
      "description": "Scaffolding (P5): one effect in a Voice Chain.",
      "type": "object",
      "properties": {
        "data": {
          "description": "A built-in effect's own data that is not a setting, as JSON text:\nthe Amp Model's capture and cabinet. Saved with the session and in\npresets, so they never depend on a file elsewhere.",
          "type": [
            "string",
            "null"
          ]
        },
        "effect": {
          "description": "Internal effect id, for example `altaudio.parametric_eq`.",
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "params": {
          "description": "Parameter values by name.",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        },
        "plugin_state": {
          "description": "A VST3 plug-in's own settings (everything set in its window), as the\nplug-in saved them, base64. Only on plug-in slots (`vst3:` effects).",
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "description": "Which of the numbered slots it shows in (0 is the first), so a chain\ncan leave gaps. Effects still run in list order. None follows the\none before.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "preset": {
          "description": "Name of the preset last loaded, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "sidechain": {
          "description": "Sidechain: the track or bus whose sound drives this effect's\nlevel detector (for ducking music under a voice, for example).\nThe key is that track's or bus's sound after its Voice Chain,\nbefore its fader. Only effects with a detector use it, and only\non track and bus chains. None listens to the effect's own input.",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "required": [
        "id",
        "effect",
        "enabled",
        "params"
      ]
    },
    "Envelope": {
      "description": "An automation lane.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "points": {
          "description": "Points sorted by position.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EnvelopePoint"
          }
        },
        "target": {
          "$ref": "#/$defs/EnvelopeTarget"
        }
      },
      "required": [
        "id",
        "target",
        "enabled",
        "points"
      ]
    },
    "EnvelopeCurve": {
      "description": "How the value moves from one point to the next.",
      "type": "string",
      "enum": [
        "linear",
        "hold",
        "spline"
      ]
    },
    "EnvelopePoint": {
      "description": "A single automation point.",
      "type": "object",
      "properties": {
        "curve": {
          "$ref": "#/$defs/EnvelopeCurve"
        },
        "position": {
          "description": "Position in session samples. For clip envelopes this is relative\nto the clip's left edge.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "position",
        "value",
        "curve"
      ]
    },
    "EnvelopeTarget": {
      "description": "What an envelope automates.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "volume"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pan"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Scaffolding (P5): a parameter of an effect in the owner's Voice Chain.",
          "type": "object",
          "properties": {
            "param": {
              "type": "string"
            },
            "slot_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "effect_param"
            }
          },
          "required": [
            "type",
            "slot_id",
            "param"
          ]
        },
        {
          "description": "3D Space sessions: one setting of the owner's spot in the room.",
          "type": "object",
          "properties": {
            "param": {
              "$ref": "#/$defs/SpaceParam"
            },
            "type": {
              "type": "string",
              "const": "space"
            }
          },
          "required": [
            "type",
            "param"
          ]
        }
      ]
    },
    "EpisodeMetadata": {
      "description": "Scaffolding (P6, P7): episode metadata for show sync and export.",
      "type": "object",
      "properties": {
        "artist": {
          "type": [
            "string",
            "null"
          ]
        },
        "artwork": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "episode_number": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "explicit": {
          "type": "boolean"
        },
        "season_number": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "show": {
          "type": [
            "string",
            "null"
          ]
        },
        "show_id": {
          "description": "Scaffolding (P6): show id in Podcast Manager.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "explicit"
      ]
    },
    "Fade": {
      "description": "A clip fade. Length 0 means no fade.",
      "type": "object",
      "properties": {
        "curve": {
          "description": "Curve bend from -1.0 to 1.0. 0.0 is the neutral shape.",
          "type": "number",
          "format": "double"
        },
        "length": {
          "description": "Length in session samples.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "shape": {
          "$ref": "#/$defs/FadeShape"
        }
      },
      "required": [
        "length",
        "shape",
        "curve"
      ]
    },
    "FadeShape": {
      "description": "Shape of a fade curve.",
      "type": "string",
      "enum": [
        "linear",
        "logarithmic",
        "cosine"
      ]
    },
    "Marker": {
      "description": "A point or range marker on the session timeline.",
      "type": "object",
      "properties": {
        "chapter": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChapterInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "description": "`#rrggbb`. None uses the color of the marker's type.",
          "type": [
            "string",
            "null"
          ]
        },
        "contracted_duration": {
          "description": "Scaffolding (P5): contracted length of an ad slot, in session\nsamples.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "description": {
          "type": "string"
        },
        "duration": {
          "description": "Length in session samples. 0 is a point marker.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "$ref": "#/$defs/MarkerKind"
        },
        "name": {
          "type": "string"
        },
        "position": {
          "description": "Position in session samples.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "position",
        "duration",
        "description"
      ]
    },
    "MarkerKind": {
      "description": "Kind of marker.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "cue",
            "subclip"
          ]
        },
        {
          "description": "Scaffolding (P7): a podcast chapter embedded on export.",
          "type": "string",
          "const": "chapter"
        },
        {
          "description": "Scaffolding (P5): an ad slot. Carries a contracted duration so\nthe read can be timed.",
          "type": "string",
          "const": "ad_slot"
        },
        {
          "description": "Scaffolding (P7): a region exported as a social media clip.",
          "type": "string",
          "const": "social_clip"
        },
        {
          "description": "Scaffolding (later, disc and broadcast work): where a CD track starts.",
          "type": "string",
          "const": "cd_track"
        },
        {
          "description": "Scaffolding (later, broadcast work): a timed cart, such as a jingle\nor a spot that must fit a set length.",
          "type": "string",
          "const": "cart_timer"
        }
      ]
    },
    "MasterTrack": {
      "description": "The master track.",
      "type": "object",
      "properties": {
        "channels": {
          "$ref": "#/$defs/ChannelLayout"
        },
        "effects": {
          "$ref": "#/$defs/EffectChain"
        },
        "envelopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Envelope"
          }
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "volume_db": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "channels",
        "height",
        "volume_db",
        "effects",
        "envelopes"
      ]
    },
    "MediaRef": {
      "description": "A source audio file referenced by clips.",
      "type": "object",
      "properties": {
        "channels": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "length": {
          "description": "Length in samples at the file's own rate.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "path": {
          "description": "Absolute path when the session was last saved.",
          "type": "string"
        },
        "relative_path": {
          "description": "Path relative to the session file. Tried first on load so a\nsession folder can move between drives or machines.",
          "type": [
            "string",
            "null"
          ]
        },
        "sample_rate": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "path",
        "sample_rate",
        "channels",
        "length"
      ]
    },
    "MidiClip": {
      "description": "A MIDI clip: notes, placed in beats so they follow the tempo.",
      "type": "object",
      "properties": {
        "color": {
          "description": "`#rrggbb` or a palette token. None uses the track color.",
          "type": [
            "string",
            "null"
          ]
        },
        "gain_db": {
          "description": "Clip level in dB: notes play harder or softer by this much (their\nvelocity is scaled), up to the hardest a note can play.",
          "type": "number",
          "format": "double"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "length": {
          "description": "Beats. Notes past the end are not played.",
          "type": "number",
          "format": "double"
        },
        "muted": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Note"
          }
        },
        "start": {
          "description": "Timeline position of the clip's left edge, in beats.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "id",
        "name",
        "start",
        "length",
        "notes"
      ]
    },
    "Note": {
      "description": "One note in a MIDI clip.",
      "type": "object",
      "properties": {
        "length": {
          "description": "Beats.",
          "type": "number",
          "format": "double"
        },
        "pitch": {
          "description": "MIDI note number, 0 to 127 (60 is middle C).",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "start": {
          "description": "Beats from the clip's start.",
          "type": "number",
          "format": "double"
        },
        "velocity": {
          "description": "1 to 127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "required": [
        "pitch",
        "velocity",
        "start",
        "length"
      ]
    },
    "Output": {
      "description": "Where a track or bus sends its output.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "master"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "bus_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "bus"
            }
          },
          "required": [
            "type",
            "bus_id"
          ]
        }
      ]
    },
    "Send": {
      "description": "An aux send: a copy of a track's or bus's sound sent on to a bus at\nits own level, for example to a shared reverb. A pre-fader send\nignores the sender's fader and pan but still follows its mute and solo.",
      "type": "object",
      "properties": {
        "bus_id": {
          "type": "string",
          "format": "uuid"
        },
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "level_db": {
          "type": "number",
          "format": "double"
        },
        "pan": {
          "type": "number",
          "format": "double"
        },
        "pre_fader": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "bus_id",
        "level_db",
        "pan",
        "pre_fader",
        "enabled"
      ]
    },
    "SessionModes": {
      "description": "Panel mode toggles, saved with the session.",
      "type": "object",
      "properties": {
        "podcast": {
          "description": "Shows the Chapters, Transcript, and Podcast Publish panels.",
          "type": "boolean"
        },
        "voiceover": {
          "description": "Shows the Script, Take Lanes, and Delivery Check panels.",
          "type": "boolean"
        }
      },
      "required": [
        "podcast",
        "voiceover"
      ]
    },
    "SessionView": {
      "description": "Saved editor view state.",
      "type": "object",
      "properties": {
        "playhead": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "samples_per_pixel": {
          "description": "Zoom as session samples per screen pixel.",
          "type": "number",
          "format": "double"
        },
        "scroll": {
          "description": "Left edge of the visible timeline, in session samples.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "scroll_y": {
          "description": "Vertical scroll of the track area, in pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRange"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "samples_per_pixel",
        "scroll",
        "scroll_y",
        "playhead"
      ]
    },
    "Space": {
      "description": "What makes a session a 3D Space session.",
      "type": "object",
      "properties": {
        "layout": {
          "description": "The layout it plays in and exports to unless an export picks another.",
          "$ref": "#/$defs/SpaceLayout"
        },
        "listen": {
          "$ref": "#/$defs/SpaceListen",
          "default": "stereo"
        }
      },
      "required": [
        "layout"
      ]
    },
    "SpaceLayout": {
      "description": "A speaker layout a 3D Space session can be placed onto. Spots are\nkept in room terms, so any session plays and exports in any layout.",
      "type": "string",
      "enum": [
        "2.0",
        "5.1",
        "7.1",
        "5.1.2",
        "7.1.2",
        "5.1.4",
        "7.1.4"
      ]
    },
    "SpaceListen": {
      "description": "How a 3D Space session is heard while working.",
      "oneOf": [
        {
          "description": "Each sound folded to stereo by where it sits left to right.",
          "type": "string",
          "const": "stereo"
        },
        {
          "description": "The layout's speakers heard as if around a head, for headphones.",
          "type": "string",
          "const": "binaural"
        },
        {
          "description": "Each speaker to its own output of the audio device, for a room\nwith the layout's speakers (Settings > Audio Hardware maps them).",
          "type": "string",
          "const": "speakers"
        }
      ]
    },
    "SpaceParam": {
      "description": "A setting of a spot in the room that automation can move. Values use\nthe spot's own units (see `SpacePos`).",
      "type": "string",
      "enum": [
        "x",
        "y",
        "z",
        "size",
        "width",
        "rotation",
        "lfe",
        "spread",
        "spatialize"
      ]
    },
    "SpacePos": {
      "description": "A spot in the room. x runs left (-1) to right (1), y back (-1) to\nfront (1), z ear level (0) to ceiling (1), and below ear level down\nto -1.",
      "type": "object",
      "properties": {
        "lfe": {
          "description": "How much of it also feeds the low-frequency channel, 0 (none) to 1\n(full level), low-passed at 120 Hz.",
          "type": "number",
          "format": "double"
        },
        "rotation": {
          "description": "Stereo sources: the pair turned around its spot, in degrees,\nclockwise seen from above (90 puts the left side in front).",
          "type": "number",
          "format": "double"
        },
        "size": {
          "description": "0 is a point; 1 fills the room.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "spatialize": {
          "description": "Stereo sources: how much of the difference between its sides is\nsent, delayed and decorrelated, to the surround and height\nspeakers, with what the sides share fed to the center, 0 to 1.",
          "type": "number",
          "format": "double"
        },
        "spread": {
          "description": "How much of it is spread through the room as a diffuse field\n(decorrelated copies on every speaker in use), 0 (none) to 1 (all).",
          "type": "number",
          "format": "double"
        },
        "width": {
          "description": "Stereo sources: how far left and right of the spot their two\nsides sit, 0 (together) to 1 (a full room width apart each way).",
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "z": {
          "type": "number",
          "format": "double",
          "default": 0.0
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "StretchAdvanced": {
      "description": "Finer stretch settings. The window size sets the length of the\nanalysis frames; the rest are kept for files that carry them.",
      "type": "object",
      "properties": {
        "high_precision": {
          "description": "Higher precision takes longer to work out.",
          "type": "boolean"
        },
        "preserve_formants": {
          "description": "Keep the voice's character when the pitch moves.",
          "type": "boolean"
        },
        "transient_sensitivity": {
          "description": "How readily a sharp attack starts a new frame, 0 to 100.",
          "type": "number",
          "format": "double"
        },
        "window_ms": {
          "description": "Analysis frame length in milliseconds (about 10 to 100).",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "window_ms",
        "transient_sensitivity",
        "preserve_formants",
        "high_precision"
      ]
    },
    "Tempo": {
      "description": "The session's tempo and meter: where it starts, and any changes later\nin the song. MIDI clips, bars and beats, and the metronome follow it.",
      "type": "object",
      "properties": {
        "beat_unit": {
          "description": "The note one beat is, the bottom of the time signature: 4 in 4/4,\n8 in 6/8. Files from before time signature changes get 4.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "beats_per_bar": {
          "description": "Beats in a bar, the top of the time signature: 4 in 4/4, 6 in 6/8.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "bpm": {
          "description": "Beats (quarter notes) per minute.",
          "type": "number",
          "format": "double"
        },
        "changes": {
          "description": "Tempo and time signature changes, in bar order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TempoChange"
          }
        }
      },
      "required": [
        "bpm",
        "beats_per_bar"
      ]
    },
    "TempoChange": {
      "description": "A tempo and time signature change at the start of a bar.",
      "type": "object",
      "properties": {
        "bar": {
          "description": "Bars from the start of the session where it takes over: 1 is the\nsecond bar. Always 1 or more.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "beat_unit": {
          "type": "integer",
          "format": "uint32",
          "default": 4,
          "minimum": 0
        },
        "beats_per_bar": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "bpm": {
          "type": "number",
          "format": "double"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "id",
        "bar",
        "bpm",
        "beats_per_bar"
      ]
    },
    "TimeRange": {
      "description": "A span of the timeline.",
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "Track": {
      "description": "An audio track.",
      "type": "object",
      "properties": {
        "channels": {
          "$ref": "#/$defs/ChannelLayout"
        },
        "clips": {
          "description": "Clips on this track. Order does not matter; position does.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Clip"
          }
        },
        "collapsed": {
          "description": "Folded down to its name row in the Editor. Left out of the file when off.",
          "type": "boolean"
        },
        "color": {
          "description": "Track color as `#rrggbb`. None uses the default.",
          "type": [
            "string",
            "null"
          ]
        },
        "effects": {
          "$ref": "#/$defs/EffectChain"
        },
        "envelopes": {
          "description": "Track automation lanes.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Envelope"
          }
        },
        "height": {
          "description": "Track height in the Editor, in pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "hidden": {
          "description": "Hidden from the Editor and Mixer lists. The track still plays and\nmixes. Left out of the file when off.",
          "type": "boolean"
        },
        "host_profile_id": {
          "description": "Scaffolding (P5): id of the host profile applied to this track,\nfor example `host`.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "input": {
          "description": "Scaffolding (P4): hardware input name.",
          "type": [
            "string",
            "null"
          ]
        },
        "instrument": {
          "description": "MIDI tracks: the VST3 instrument that plays the notes. Its sound\nthen goes through the track's Voice Chain like any track's.",
          "anyOf": [
            {
              "$ref": "#/$defs/EffectSlot"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "description": "Audio or MIDI. Left out of the file for audio tracks.",
          "$ref": "#/$defs/TrackKind"
        },
        "midi_clips": {
          "description": "MIDI tracks: their clips.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MidiClip"
          }
        },
        "monitor_input": {
          "description": "Scaffolding (P4): input monitoring on.",
          "type": "boolean"
        },
        "mono": {
          "description": "Folds the track's left and right into one centered signal, after\nits Voice Chain and before its fader and pan. Left out of the\nfile when off.",
          "type": "boolean"
        },
        "muted": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/Output"
        },
        "pan": {
          "type": "number",
          "format": "double"
        },
        "polarity_inverted": {
          "description": "Flips the track's polarity (multiplies it by -1). Left out of the\nfile when off.",
          "type": "boolean"
        },
        "record_armed": {
          "description": "Scaffolding (P4): armed for recording.",
          "type": "boolean"
        },
        "role": {
          "$ref": "#/$defs/TrackRole"
        },
        "sends": {
          "description": "Aux sends to buses.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Send"
          }
        },
        "show_automation": {
          "description": "Its automation lanes show under it in the Editor. Left out of the\nfile when off.",
          "type": "boolean"
        },
        "solo": {
          "type": "boolean"
        },
        "space": {
          "description": "3D Space sessions: where the track sits in the room (in place of\nits pan). None sits at the front center.",
          "anyOf": [
            {
              "$ref": "#/$defs/SpacePos"
            },
            {
              "type": "null"
            }
          ]
        },
        "volume_db": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "channels",
        "height",
        "volume_db",
        "pan",
        "muted",
        "solo",
        "record_armed",
        "monitor_input",
        "output",
        "sends",
        "effects",
        "clips",
        "envelopes"
      ]
    },
    "TrackKind": {
      "description": "What a track holds.",
      "oneOf": [
        {
          "description": "Audio clips.",
          "type": "string",
          "const": "audio"
        },
        {
          "description": "MIDI clips, played by the track's instrument.",
          "type": "string",
          "const": "midi"
        }
      ]
    },
    "TrackRole": {
      "description": "What kind of voice a track carries.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "standard"
          ]
        },
        {
          "description": "Scaffolding (P5): remote guest. Gets a softer gate, heavier noise\nreduction, and a telephone-bandwidth EQ.",
          "type": "string",
          "const": "guest"
        }
      ]
    }
  }
}
